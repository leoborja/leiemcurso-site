es":[{"data":"2025-08-20T23:33:00Z","orgao":"MESA","descricao":"Apresentação de Proposição","despacho":"Apresentação da PEC n. 32/2025 (Proposta de Emenda à Constituição), pelos Deputado Delegado Palumbo (MDB/SP) e outros, que \"Esta Lei altera o artigo 5º, inciso XLIII, da Constituição Federal, o qual prevê que nos casos de crimes previstos neste inciso, a pena deverá ser cumprida integralmente em regime fechado, por eles respondendo os mandantes, os executores e os que, podendo evitá-los, se omitirem, e dá outras providências\".","tipo_codigo":"100","url":"https://www.camara.leg.br/proposicoesWeb/prop_mostrarintegra?codteor=2982206"},{"data":"2025-08-20T23:34:00Z","orgao":"MESA","descricao":"Relatório de Conferência de Assinaturas","despacho":"Relatório de Conferência de Assinaturas Eletrônicas.","tipo_codigo":"1042","url":"https://www.camara.leg.br/proposicoesWeb/prop_mostrarintegra?codteor=2982207"},{"data":"2026-08-12T20:25:00Z","orgao":"PEC03215","descricao":"Apresentação de Requerimento","despacho":"Apresentação do REQ n. 1/2026 (Requerimento de Audiência Pública), pela Deputada Talíria Petrone (PSOL/RJ -Fdr PSOL-REDE), que \"Requer a realização de Audiência Pública no âmbito da Comissão Especial sobre a redução da maioridade penal (PEC 32/2015) para debater a idade penal como cláusula pétrea e o controle de constitucionalidade da redução frente aos direitos e garantias individuais imutáveis da Constituição de 1988, sugerindo os seguintes especialistas: Dr. Rodrigo Azambuja Martins, representante da Defensoria Pública do Estado do Riode Janeiro (DP/RJ) e Coalizão pela Socioeducação; Sra. Mariana Chies Santiago, representante do Instituto Brasileiro de Ciências Criminais (IBCCRIM); representante da Advocacia Geral da União (AGU); representante do Conselho Federal de Serviço Social (CFESS)\".","tipo_codigo":"194","url":"https://www.camara.leg.br/proposicoesWeb/prop_mostrarintegra?codteor=3171469"},{"data":"2026-09-01T17:00:00Z","orgao":"PEC03215","descricao":"Aprovação de Requerimento","despacho":"Aprovado o requerimento nº 1/2026,da Sra. Talíria Petrone que requer a realização de Audiência Pública no âmbito da Comissão Especial sobre a redução da maioridade penal (PEC 32/2015) para debater a idade penal como cláusula pétrea e o controle de constitucionalidade da redução frente aos direitos e garantias individuais imutáveis da Constituição de 1988, sugerindo os seguintes especialistas: Dr. Rodrigo Azambuja Martins, representante da Defensoria Pública do Estado do Riode Janeiro (DP/RJ) e Coalizão pela Socioeducação; Sra. Mariana Chies Santiago, representante do Instituto Brasileiro de Ciências Criminais (IBCCRIM); representante da Advocacia Geral da União (AGU); representante do Conselho Federal de Serviço Social (CFESS).","tipo_codigo":"195","url":null}],"votacoes":[{"id":"2643316-2","data":"2026-09-01","orgao":"PEC03215","descricao":"Aprovado o Requerimento.","aprovada":true,"nominal":false,"placar":{"sim":0,"nao":0,"abstencao":null,"obstrucao":null,"outros":0},"url":"https://dadosabertos.camara.leg.br/api/v2/votacoes/2643316-2","orientacoes":[],"votos":[]}],"vinculo_outra_casa":null,"regime":".","apreciacao":"Proposição Sujeita à Apreciação do Plenário","gerado_em":"2026-11-08T17:46:53Z"}