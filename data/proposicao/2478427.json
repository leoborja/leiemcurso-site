r","partido":"UNIÃO","uf":"PE","tipo":"Deputado","id_deputado":74478,"id_parlamentar":74478,"proponente":false},{"nome":"Soraya Santos","partido":"PL","uf":"RJ","tipo":"Deputado","id_deputado":178946,"id_parlamentar":178946,"proponente":false}],"relatores":[],"etapas":[{"etapa":"apresentado","inicio":"2024-12-11","fim":null}],"tramitacoes":[{"data":"2024-12-11T13:56:00Z","orgao":"MESA","descricao":"Apresentação de Proposição","despacho":"Apresentação da PEC n. 48/2024 (Proposta de Emenda à Constituição), pelo Deputado Bibo Nunes (PL/RS) e outros, que \"Altera o art. 53 da Constituição Federal para deixar explícito que a imunidade material de Deputados e Senadores se aplica independentemente do local em que forem proferidas opiniões, palavras e votos, e para determinar ao Ministro do Supremo Tribunal Federal que, no exercício de suas funções, contrariar esta disposição, a pena de perda do cargo, sem vencimentos e com inabilitação, por até cinco anos, para o exercício de qualquer função pública\".","tipo_codigo":"100","url":"https://www.camara.leg.br/proposicoesWeb/prop_mostrarintegra?codteor=2838887"},{"data":"2024-12-11T15:00:00Z","orgao":"MESA","descricao":"Relatório de Conferência de Assinaturas","despacho":"Relatório de Conferência de Assinaturas Eletrônicas.","tipo_codigo":"1042","url":"https://www.camara.leg.br/proposicoesWeb/prop_mostrarintegra?codteor=2838890"}],"votacoes":[],"vinculo_outra_casa":null,"regime":".","apreciacao":"Proposição Sujeita à Apreciação do Plenário","gerado_em":"2026-11-08T17:46:53Z"}