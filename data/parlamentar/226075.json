":"2023-08-09","orgao":"PLEN","voto":"Não","partido":"PL","orientacao_partido":"Liberado","orientacao_bancada":"PL"},{"votacao_id":"2355627-8","proposicao_id":2350875,"sigla":"PL 1037/2023","data":"2023-08-01","orgao":"PLEN","voto":"Sim","partido":"PL","orientacao_partido":"Sim","orientacao_bancada":"PL"},{"votacao_id":"2367064-82","proposicao_id":2367064,"sigla":"PL 2920/2023","data":"2023-07-07","orgao":"PLEN","voto":"Não","partido":"PL","orientacao_partido":"Não","orientacao_bancada":"PL"},{"votacao_id":"2367064-68","proposicao_id":2367064,"sigla":"PL 2920/2023","data":"2023-07-07","orgao":"PLEN","voto":"Não","partido":"PL","orientacao_partido":"Não","orientacao_bancada":"PL"},{"votacao_id":"2367064-66","proposicao_id":2367064,"sigla":"PL 2920/2023","data":"2023-07-07","orgao":"PLEN","voto":"Sim","partido":"PL","orientacao_partido":"Sim","orientacao_bancada":"PL"},{"votacao_id":"2360503-35","proposicao_id":2360503,"sigla":"PL 2384/2023","data":"2023-07-07","orgao":"PLEN","voto":"Sim","partido":"PL","orientacao_partido":"Obstrução","orientacao_bancada":"PL"},{"votacao_id":"2360503-27","proposicao_id":2360503,"sigla":"PL 2384/2023","data":"2023-07-07","orgao":"PLEN","voto":"Sim","partido":"PL","orientacao_partido":"Obstrução","orientacao_bancada":"PL"}],"discursos":[{"data":"2026-11-04","hora":"17:44","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":null,"url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=5%2F11%2F2026&txPagina=&txSuplemento=&enviar=Pesquisar"},{"data":"2026-11-04","hora":"15:36","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":null,"url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=5%2F11%2F2026&txPagina=&txSuplemento=&enviar=Pesquisar"},{"data":"2026-10-28","hora":"15:36","tipo":"PELA ORDEM","fase":"Breves Comunicações","sumario":"A Deputada contestou a fala de Deputado de partido de Esquerda sobre suposta decepção com Flávio Bolsonaro e afirmou que a verdadeira frustração deveria recair sobre Lula e seu filho, Lulinha, citando a acusação de recebimento de mesada com recursos desviados de aposentados. Além disso, questionou a coerência do Parlamentar ao ignorar, segundo a oradora, o contrato de 139 milhões com Daniel Vorcaro, ligado à esposa de Alexandre de Moraes, e sustentou que o discurso adversário confundiu a quem pretendia representar.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/226075/discursos?dataInicio=2026-10-28&dataFim=2026-10-28"},{"data":"2026-10-27","hora":"17:24","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada defendeu a decisão de Flávio Bolsonaro de deixar o Brasil, alegando perseguição política e necessidade de proteger a família. Além disso, criticou o Ministro Cristiano Zanin pela prorrogação da votação e questionou a divulgação de uma representação da Polícia Federal (PF) apenas sete minutos após o resultado eleitoral, levantando suspeitas de premeditação. Também atribuiu ao Ministro Alexandre de Moraes a intenção de utilizar Flávio Bolsonaro como instrumento de pressão sobre Parlamentares e destacou o fortalecimento da Direita no Senado. Por fim, defendeu a autonomia do Poder Legislativo e manifestou preocupação com o devido processo legal e a democracia.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/226075/discursos?dataInicio=2026-10-27&dataFim=2026-10-27"},{"data":"2026-08-11","hora":"19:12","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada lamentou o avanço da violência no Ceará e apontou a morte de um policial de 27 anos, assassinado e carbonizado dentro do carro após sair do serviço, como demonstração da fragilidade da segurança pública. Além disso, criticou o Governador Elmano de Freitas por afirmar que o Estado viveria o melhor momento da segurança pública e responsabilizou as administrações do Partido dos Trabalhadores (PT) pela situação. Por fim, defendeu a retirada do partido do Governo do Ceará nas eleições de outubro.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/226075/discursos?dataInicio=2026-08-11&dataFim=2026-08-11"},{"data":"2023-10-25","hora":"17:24","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"A Deputada registrou a presença, no plenário da Casa, do Pastor Rafael, da Igreja de Deus no Brasil, presente em Brasília para realizar a CUMBRE, evento que reúne lideranças da igreja em toda a América Latina; e do Pastor Neivison Pires, da Igreja Assembleia de Deus de Fortaleza.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=26%2F10%2F2023&txPagina=104&txSuplemento=&enviar=Pesquisar"},{"data":"2023-10-24","hora":"18:28","tipo":"PELA ORDEM","fase":"Breves Comunicações","sumario":"A Deputada expressou preocupações sobre o Projeto de Lei nº 5.034, de 2023, que visa equiparar as ações e métodos que objetivam a conversão da orientação sexual e da identidade de gênero ao crime de tortura. Levantou questões sobre a conceituação da identidade de gênero, citando Judith Butler, fundadora do conceito. Ela também questionou a existência de propagandas que promovem a conversão da orientação sexual e criticou o PSOL por defender a interferência na vida sexual de crianças. Ainda mencionou um caso trágico de uma criança que sofreu as consequências de ideologias extremas. Por fim, propôs projeto de lei para criminalizar a tentativa de mudança de sexo em menores, considerando-o um crime hediondo.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=25%2F10%2F2023&txPagina=113&txSuplemento=&enviar=Pesquisar"},{"data":"2023-10-24","hora":"17:52","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada registrou o transcurso dos 14 anos de atividades religiosas e educacionais da Assembleia de Deus Novo Viver em Fortaleza, Estado do Ceará. A oradora parabenizou o Pastor Nogueira e todos os membros da instituição, que, recentemente, reinaugurou o templo central e o Colégio Adventista na capital cearense.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=25%2F10%2F2023&txPagina=102&txSuplemento=&enviar=Pesquisar"},{"data":"2023-10-18","hora":"20:36","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"A Deputada expressou sua indignação em relação à pressão da ONU para que o Brasil legalize o aborto em nome dos direitos das mulheres. Criticou a escolha da Arábia Saudita pela ONU como defensora dos direitos das mulheres, apontando para as restrições e abusos aos direitos das mulheres naquele país. Enfatizou que 80% da população brasileira é contra o aborto e que as mulheres brasileiras rejeitam a violência do aborto. Destacou a soberania da vontade das mulheres brasileiras e recusou qualquer tentativa de imposição da cultura da morte e valores estrangeiros, incluindo o aborto, pela ONU. A oradora desafiou a ONU a primeiro lidar com as questões em seu próprio conselho de direitos femininos antes de tentar impor suas opiniões ao Brasil, enfatizando que as mulheres brasileiras são livres e não se submeterão a uma colonização ideológica.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=19%2F10%2F2023&txPagina=179&txSuplemento=&enviar=Pesquisar"},{"data":"2023-10-18","hora":"19:28","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"A Deputada expressou sua preocupação com um incidente ocorrido em uma igreja evangélica em Fortaleza, que foi alvo de um ataque e encontraram um animal sacrificado no altar, acompanhado por uma mensagem satânica. Ela solidarizou-se com os fiéis afetados e cobrou ação das autoridades, destacando o papel da delegacia especializada em crimes contra a liberdade de fé criada no Estado do Ceará.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=19%2F10%2F2023&txPagina=147&txSuplemento=&enviar=Pesquisar"},{"data":"2023-10-17","hora":"18:00","tipo":"PELA ORDEM","fase":"Breves Comunicações","sumario":"A Deputada refutou alegações anteriores sobre o bombardeio de um hospital em Gaza, afirmando que as forças israelenses provaram que o ataque foi realizado pela Jihad Islâmica. Na ocasião, destacou Projeto de Lei (PL), de sua autoria, visando proteger mulheres e crianças de exposição a conteúdo inapropriado em eventos esportivos. O PL proíbe o patrocínio de eventos esportivos por sites que promovem prostituição, especialmente quando recebem verba pública. A Parlamentar ressaltou que a iniciativa tem como objetivo valorizar e proteger as mulheres, além de defender as crianças e a integridade do esporte.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=18%2F10%2F2023&txPagina=98&txSuplemento=&enviar=Pesquisar"},{"data":"2023-10-17","hora":"17:32","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada contestou informações que considera falsas sobre o papel de Israel em recente ataque a um hospital em Gaza. Defendeu que, ao contrário do que tem sido divulgado, o míssil que atingiu o hospital partiu da Jihad Islâmica, e não de Israel. Falou também sobre a situação nos hospitais israelenses, onde afirmou que terroristas estão sendo tratados por médicos, enquanto denunciou assassinatos de profissionais de saúde por parte do grupo Hamas. A Parlamentar frisou a importância de valorizar a verdade.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=18%2F10%2F2023&txPagina=90&txSuplemento=&enviar=Pesquisar"},{"data":"2023-09-26","hora":"18:32","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada expressou sua preocupação com a implantação de políticas públicas defendidas pelo movimento LGBT que procuram convencer a sociedade da existência de crianças trans. Afirmou que a ideia ganha força na universidade pública, com a oferta de tratamentos hormonais que aviltam a saúde física e mental de adolescentes, e no Governo Lula, por meio da Resolução nº 715, da Ministra da Saúde, Nísia Trindade, que apoia a cirurgia de mudança de sexo a partir dos 14 anos de idade. Enfatizou que em outros países, adultos que aceitaram o procedimento na adolescência estão processando o Estado por ter se pautado pela ideologia LGBT. Com base nessas argumentações, anunciou a apresentação de projeto de lei que tipifica como crime hediondo qualquer iniciativa que traga prejuízos à saúde da criança em nome de uma ideologia, seja por meio de hormonoterapia ou por mudança de sexo. A oradora manifestou a necessidade de se defender a infância, garantindo que nenhuma ideologia mutile as crianças brasileiras.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=27%2F9%2F2023&txPagina=118&txSuplemento=&enviar=Pesquisar"},{"data":"2023-09-20","hora":"19:56","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"A Deputada fez um alerta sobre um discurso enganoso em relação à ADPF (Arguição de Descumprimento de Preceito Fundamental) que visa a liberação do aborto até 12 semanas de gestação. Argumentou que fetos de 12 semanas já têm características humanas bem formadas e destacou como é fácil desumanizar um bebê tão pequeno. Fez uma conexão histórica, comparando a desumanização proposta com o tratamento injusto dado aos negros e judeus em outras épocas. Por fim, enfatizou a importância de preservar a vida, defendendo que o útero das mulheres brasileiras deve ser um lugar de vida sagrada e inviolável, de acordo com a Constituição.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=21%2F9%2F2023&txPagina=167&txSuplemento=&enviar=Pesquisar"},{"data":"2023-09-20","hora":"19:32","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"A Deputada parabenizou o Deputado Osmar Terra pela aprovação de um projeto de lei que aumenta as penas para crimes contra crianças e adolescentes. Ressaltou a importância da proteção da infância e destacou que a moral de uma nação se reflete em sua capacidade de cuidar de suas crianças. Como mãe e gestante, ela enfatizou o valor da vida e solicitou o apoio dos Parlamentares para a aprovação do requerimento de apreciação em regime de urgência do Estatuto do Nascituro.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=21%2F9%2F2023&txPagina=159&txSuplemento=&enviar=Pesquisar"},{"data":"2023-08-23","hora":"14:40","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada convidou as mulheres do Estado do Ceará para receber, em Fortaleza, a ex-Primeira-Dama do Brasil Michelle Bolsonaro em evento organizado pelo PL Mulher e programado para setembro de 2023. A oradora ressaltou a ascendência cearense de Michelle Bolsonaro e o título de Cidadã Fortalezense concedido à ex-Primeira Dama. A Parlamentar antecipou o objetivo do evento: mostrar que a mulher nordestina é conservadora e rejeita, por exemplo, a prática do aborto.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=24%2F8%2F2023&txPagina=65&txSuplemento=&enviar=Pesquisar"},{"data":"2023-08-15","hora":"18:56","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"Ocorrência de apagão em Estados brasileiros. Natureza jocosa da atribuição ao ex-Presidente Jair Bolsonaro, pela esposa do Presidente Luiz Inácio Lula da Silva, da responsabilidade pela queda no abastecimento de energia elétrica. Protesto contra a anunciada compra, pelo Governo brasileiro, de energia da Venezuela. Declaração da Primeira-Dama do País a respeito da crise energética.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=16%2F8%2F2023&txPagina=123&txSuplemento=&enviar=Pesquisar"},{"data":"2023-08-02","hora":"16:28","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"Indignação com o apoio da Ministra da Saúde, Nísia Trindade, à Resolução nº 715, de 2023, do Conselho Nacional de Saúde, favorável à legalização das drogas e do aborto, bem como à redução, para 14 anos, da idade mínima para realização de terapia hormonal de mudança de sexo. Conveniência de exoneração da Ministra Nísia Trindade.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=3%2F8%2F2023&txPagina=83&txSuplemento=&enviar=Pesquisar"},{"data":"2023-08-01","hora":"21:44","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"Congratulações às Deputadas Maria do Rosário e Renata Abreu pela aprovação do Projeto de Lei nº 3, de 2023, sobre a criação do Protocolo Não é Não de atendimento à mulher vítima de violência sexual ou assédio em discotecas, estabelecimentos noturnos, eventos festivos, bares, restaurantes ou qualquer outro local de grande circulação de pessoas. Posicionamento da oradora contrário ao programa de educação sexual nas escolas, anunciado pelo Ministério da Saúde.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=2%2F8%2F2023&txPagina=105&txSuplemento=&enviar=Pesquisar"},{"data":"2023-07-04","hora":"19:44","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"Contrariedade à aprovação da proposta governamental de reforma tributária.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=5%2F7%2F2023&txPagina=127&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2026-W45","autorias":1,"votos":0,"relatorias":0,"discursos":2},{"semana":"2026-W44","autorias":0,"votos":0,"relatorias":0,"discursos":2},{"semana":"2026-W42","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W33","autorias":0,"votos":1,"relatorias":0,"discursos":1},{"semana":"2023-W43","autorias":5,"votos":8,"relatorias