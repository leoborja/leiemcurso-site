,"partido":"PSDB","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2636281-8","proposicao_id":2612930,"sigla":"PL 896/2023","data":"2026-07-01","orgao":"PLEN","voto":"Sim","partido":"PSDB","orientacao_partido":"Liberado","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2606189-10","proposicao_id":2486315,"sigla":"PL 849/2025","data":"2026-07-01","orgao":"PLEN","voto":"Sim","partido":"PSDB","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2610975-23","proposicao_id":2610975,"sigla":"MPV 1343/2026","data":"2026-06-17","orgao":"PLEN","voto":"Não","partido":"PSDB","orientacao_partido":"Não","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2382675-97","proposicao_id":2382675,"sigla":"PL 4133/2023","data":"2026-06-17","orgao":"PLEN","voto":"Sim","partido":"PSDB","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2382675-89","proposicao_id":2382675,"sigla":"PL 4133/2023","data":"2026-06-17","orgao":"PLEN","voto":"Não","partido":"PSDB","orientacao_partido":null,"orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2629954-8","proposicao_id":2423263,"sigla":"PL 957/2024","data":"2026-06-03","orgao":"PLEN","voto":"Sim","partido":"PSDB","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."}],"discursos":[{"data":"2026-07-08","hora":"16:20","tipo":"FALA DO PRESIDENTE OU NO EXERCÍCIO DA PRESIDÊNCIA","fase":"Breves Comunicações","sumario":"O Presidente em exercício manifestou satisfação pela oportunidade de presidir a sessão da Câmara dos Deputados e enalteceu a trajetória da instituição em defesa da democracia brasileira. Ademais, agradeceu a Deus e a todos que contribuíram para sua eleição ao Parlamento.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/236375/discursos?dataInicio=2026-07-08&dataFim=2026-07-08"},{"data":"2026-06-09","hora":"18:16","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado saudou a presença, na Câmara dos Deputados, dos Vereadores de Três Rios (RJ) Ana Clara, Rafael Silva, Zimar da Dengue e Prof. Anderson Muriçoca.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/236375/discursos?dataInicio=2026-06-09&dataFim=2026-06-09"},{"data":"2026-06-03","hora":"12:52","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado apresentou seis projetos de lei voltados à inclusão social, ao esporte e à preservação cultural. No campo da inclusão, o Projeto de lei nº 2.840, de 2026, determina a reserva de espaços adaptados para pessoas com transtorno de espectro autista (TEA) em estádios e arenas com mais de cinco mil lugares; o PL nº 2.839, de 2026, obriga escolinhas de futebol financiadas com recursos públicos federais a oferecerem turmas femininas; e o PL nº 2.838, de 2026, autoriza pacientes em recuperação pós-cirúrgica a utilizarem, temporariamente, vagas destinadas a idosos e pessoas com deficiência. No campo do reconhecimento cultural e turístico, o PL nº 2.837, de 2026, declara o Complexo Esportivo do Maracanã patrimônio cultural, esportivo e turístico do Brasil; o PL nº 2.835, de 2026, inclui o Museu do Flamengo na rota do turismo nacional; e o PL nº 2.825, de 2026, declara o Clube de Regatas do Flamengo patrimônio histórico, cultural e material do País. Por fim, o Deputado solicitou o apoio dos colegas para a aprovação das propostas, defendendo mais acesso, respeito e sensibilidade como valores centrais da atuação parlamentar.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/236375/discursos?dataInicio=2026-06-03&dataFim=2026-06-03"},{"data":"2026-06-02","hora":"17:44","tipo":"PELA ORDEM","fase":"Breves Comunicações","sumario":"O Deputado anunciou a apresentação do Projeto de Lei nº 2.825, de 2026, que declara o Clube de Regatas do Flamengo patrimônio histórico, cultural e imaterial do Brasil. Além disso, mencionou a existência de iniciativas relacionadas ao tema junto à Organização das Nações Unidas e argumentou que o Brasil deveria adotar medida semelhante em âmbito interno.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/236375/discursos?dataInicio=2026-06-02&dataFim=2026-06-02"},{"data":"2026-06-02","hora":"14:40","tipo":"COMO LÍDER","fase":"Breves Comunicações","sumario":"O Deputado assumiu o mandato destacando a trajetória ligada ao esporte e o compromisso de atuar em favor dos 92 Municípios do Rio de Janeiro, com foco em políticas voltadas à educação, saúde, segurança pública e desenvolvimento humano. Além disso, ressaltou a experiência na gestão esportiva do Município do Rio de Janeiro, a ampliação de equipamentos esportivos em áreas vulneráveis e a defesa do esporte como instrumento de inclusão social. Na continuidade, informou a intenção de apresentar projeto de lei para fortalecer protocolos de proteção às mulheres em eventos esportivos e grandes espetáculos, em razão da realização da Copa do Mundo Feminina de 2027 no Brasil. Também defendeu maior responsabilidade financeira no futebol, criticando práticas que transferem dívidas sem perspectiva de pagamento. Por fim, manifestou apoio à pré-candidatura de Helena Vieira ao Senado pelo Rio de Janeiro, destacando a importância da participação feminina na política.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/236375/discursos?dataInicio=2026-06-02&dataFim=2026-06-02"}],"semanas":[{"semana":"2026-W36","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W33","autorias":1,"votos":5,"relatorias":0,"discursos":0},{"semana":"2026-W30","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W29","autorias":2,"votos":1,"relatorias":2,"discursos":0},{"semana":"2026-W28","autorias":0,"votos":1,"relatorias":0,"discursos":1},{"semana":"2026-W27","autorias":0,"votos":2,"relatorias":5,"discursos":0},{"semana":"2026-W25","autorias":3,"votos":3,"relatorias":0,"discursos":0},{"semana":"2026-W24","autorias":0,"votos":0,"relatorias":0,"discursos":1},{"semana":"2026-W23","autorias":8,"votos":1,"relatorias":3,"d