"2368697-38","proposicao_id":2368697,"sigla":"PL 3025/2023","data":"2026-04-22","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":"Não","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2608575-64","proposicao_id":2608575,"sigla":"PLP 55/2026","data":"2026-04-15","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2600708-7","proposicao_id":2461363,"sigla":"PL 3838/2024","data":"2026-04-15","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2578968-7","proposicao_id":2426763,"sigla":"PL 1248/2024","data":"2026-04-15","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2581700-31","proposicao_id":2581700,"sigla":"MPV 1323/2025","data":"2026-04-07","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2503998-75","proposicao_id":2503998,"sigla":"PLP 109/2025","data":"2026-04-07","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2503998-70","proposicao_id":2503998,"sigla":"PLP 109/2025","data":"2026-04-07","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":"Não","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2611717-38","proposicao_id":2611717,"sigla":"PLP 77/2026","data":"2026-03-25","orgao":"PLEN","voto":"Sim","partido":"PODE","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2611717-33","proposicao_id":2611717,"sigla":"PLP 77/2026","data":"2026-03-25","orgao":"PLEN","voto":"Sim","partido":"PODE","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."}],"discursos":[{"data":"2026-07-15","hora":"16:08","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado prestou contas de sua atuação parlamentar e afirmou ter priorizado a articulação junto ao Governo Federal em favor de Minas Gerais. Destacou a viabilização de mais de R$ 15 milhões em investimentos para Santa Luzia (MG) e outros Municípios da região metropolitana de Belo Horizonte, bem como o destravamento de processos administrativos da Prefeitura de Santa Luzia (MG) paralisados desde 2020. Ademais, ressaltou a importância do planejamento e da continuidade na gestão pública para a obtenção de resultados.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/235620/discursos?dataInicio=2026-07-15&dataFim=2026-07-15"},{"data":"2026-07-01","hora":"15:36","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado destacou a necessidade de mais investimentos para o Município de Santa Luzia, defendendo melhorias em infraestrutura e maior atenção do poder público às demandas da população local. Além disso, prestou homenagem às mulheres brasileiras, ressaltando sua crescente participação em diversas áreas profissionais e defendendo o combate à violência de gênero e ao feminicídio. Em especial, enalteceu a nomeação da Coronel Cleide Barcelos dos Reis Rodrigues como a primeira mulher a comandar a Polícia Militar de Minas Gerais, além de mencionar a liderança feminina no Corpo de Bombeiros Militar de Minas Gerais e na Polícia Civil de Minas Gerais como exemplos do avanço das mulheres em cargos de destaque na segurança pública.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/235620/discursos?dataInicio=2026-07-01&dataFim=2026-07-01"},{"data":"2026-03-25","hora":"17:52","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado tomou posse e prestou compromisso regimental. Destacou trajetória como Vereador, suplente de Deputado Estadual e Vice-Prefeito de Santa Luzia (MG). Afirmou que chegou ao cargo com senso de responsabilidade para representar o Município, a região metropolitana e Minas Gerais. Apontou desafios locais, como falta de infraestrutura, problemas em encostas, córregos a céu aberto e enchentes, e defendeu a necessidade de investimentos e apoio institucional. Também ressaltou a importância de políticas voltadas a crianças, jovens e idosos. Por fim, agradeceu lideranças políticas, entre elas Marcos Pereira, e convidou autoridades a direcionarem recursos para Santa Luzia (MG), com foco em desenvolvimento e melhoria das condições de vida da população.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=26%2F3%2F2026&txPagina=135&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2026-W30","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W29","autorias":0,"votos":1,"relatorias":0,"discursos":1},{"semana":"2026-W28","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W27","autorias":0,"votos":3,"relatorias":0,"discursos":1},{"semana":"2026-W25","autorias":2,"votos":3,"relatorias":0,"discursos":0},{"semana":"2026-W24","autorias":2,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W23","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W22","autorias":3,"votos":8,"relatorias":0,"discursos":0},{"semana":"2026-W21","autorias":0,"votos":6,"relatorias":0,"discursos":0},{"semana":"2026-W20","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W19","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W18","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2026-W17","autorias":0,"votos":3,"relatorias":0,"discursos":0},{"semana":"2026-W16","autorias":0,"votos":3,"relatorias":0,"discursos":0},{"semana":"2026-W15","autorias":0,"votos":3,"relatorias":0,"discursos":0},{"semana":"2026-W13","autorias":0,"votos":2,"relatorias":0,"discursos":1}],"gerado_em":"2026-11-08T17:47:05Z"}