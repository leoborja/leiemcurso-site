55-9","proposicao_id":2436982,"sigla":"PL 2113/2024","data":"2024-08-28","orgao":"PLEN","voto":"Sim","partido":"UNIÃO","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpFdrPsdbCid..."},{"votacao_id":"2452211-7","proposicao_id":2452037,"sigla":"PL 3117/2024","data":"2024-08-28","orgao":"PLEN","voto":"Sim","partido":"UNIÃO","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpFdrPsdbCid..."}],"discursos":[{"data":"2024-08-28","hora":"14:08","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado agradeceu, por ocasião de sua posse como Parlamentar, ao Presidente da Câmara dos Deputados, Arthur Lira, pela liderança e ao Deputado Geraldo Mendes pela oportunidade concedida ao licenciar-se para concorrer à Prefeitura de São José dos Pinhais (PR). Ademais, agradeceu à sua família, amigos e eleitores do Paraná, destacando a votação expressiva em diversas localidades. Além disso, ressaltou sua trajetória como empresário e agropecuarista. Adicionalmente, defendeu a necessidade urgente de avanços em educação, saúde pública e reforma administrativa, bem como a importância de um novo pacto federativo com mais recursos para os Municípios. Criticou também a polarização da sociedade e sustentou a busca pelo bem comum, a igualdade e o equilíbrio entre renda e qualidade de vida. Por fim, reafirmou seu compromisso com a liberdade, justiça e o Estado Democrático de Direito.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=29%2F8%2F2024&txPagina=37&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2024-W51","autorias":2,"votos":20,"relatorias":0,"discursos":0},{"semana":"2024-W50","autorias":0,"votos":7,"relatorias":0,"discursos":0},{"semana":"2024-W49","autorias":0,"votos":4,"relatorias":0,"discursos":0},{"semana":"2024-W48","autorias":0,"votos":5,"relatorias":0,"discursos":0},{"semana":"2024-W47","autorias":0,"votos":6,"relatorias":0,"discursos":0},{"semana":"2024-W46","autorias":0,"vot