tacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2430143-72","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-10","orgao":"PLEN","voto":"Sim","partido":"PT","orientacao_partido":"Sim","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2430143-57","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-10","orgao":"PLEN","voto":"Não","partido":"PT","orientacao_partido":"Não","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2430143-45","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-10","orgao":"PLEN","voto":"Não","partido":"PT","orientacao_partido":"Não","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2447901-6","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PT","orientacao_partido":"Sim","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2447439-8","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PT","orientacao_partido":"Sim","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2399598-112","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PT","orientacao_partido":"Sim","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2399598-108","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PT","orientacao_partido":"Sim","orientacao_bancada":"Fdr PT-PCdoB-PV"}],"discursos":[{"data":"2024-10-29","hora":"15:40","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado expressou gratidão aos 123.500 eleitores de Campinas (SP) que confiaram nele durante as eleições, reafirmando seu compromisso com a fiscalização e a luta por uma cidade mais justa. Destacou a grave questão dos acidentes de trabalho em silos, que resultaram em 86 mortes em 2022, muitas das quais poderiam ser evitadas com melhor regulamentação e fiscalização. Mencionou a recente tragédia em Palotina (PR), que deixou dez mortos, e alertou sobre a subnotificação desses casos. Pediu a atualização da legislação e a implementação de tecnologias para prevenir acidentes, enfatizando a necessidade de ação legislativa para proteger vidas e garantir a segurança dos trabalhadores no setor.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=30%2F10%2F2024&txPagina=67&txSuplemento=&enviar=Pesquisar"},{"data":"2024-08-13","hora":"16:00","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado destacou a importância do Sistema Único de Saúde (SUS) e os desafios da saúde pública em Campinas (SP), especialmente nas unidades de pronto atendimento e atenção primária. Elogiou o Centro de Atenção Integral à Saúde da Mulher (CAISM) da UNICAMP, que busca investimentos para modernização, como um novo acelerador linear para tratamento de câncer, e parabenizou a Sociedade Campineira de Educação e Instrução, vinculada à PUC, por assumir a gestão da Maternidade de Campinas, uma das maiores do Brasil. Por fim, reiterou seu apoio a essas instituições e ao SUS.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=14%2F8%2F2024&txPagina=68&txSuplemento=&enviar=Pesquisar"},{"data":"2024-07-10","hora":"18:28","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado ressaltou a importância histórica da votação da reforma tributária na Câmara dos Deputados, destacando-a como uma transformação crucial para o Brasil. Enfatizou que o sistema tributário brasileiro historicamente exacerbou as desigualdades sociais, sendo um tema tabu por envolver retirada de benefícios e enfrentamento de injustiças. Elogiou a coragem do Presidente Lula, do Ministro Fernando Haddad e dos colegas Deputados em promover uma reforma que simplifica, organiza e introduz dispositivos,como o cashback, garantindo maior progressividade na tributação. Celebrou, também, a isenção da tributação sobre a cesta básica como uma conquista significativa que reduzirá os custos dos alimentos e melhorará a segurança alimentar da população. Concluiu parabenizando os envolvidos por contribuírem para uma mudança positiva na história do Brasil.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=11%2F7%2F2024&txPagina=199&txSuplemento=&enviar=Pesquisar"},{"data":"2024-07-09","hora":"21:32","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado expressou preocupação com a violência contra mulheres em Campinas (SP) e anunciou o envio de um ofício à Ministra das Mulheres, Cida Gonçalves, solicitando a instalação de uma unidade da Casa da Mulher Brasileira na cidade. Destacou que essa iniciativa é crucial para oferecer acolhimento, proteção e serviços integrados às vítimas de violência, incluindo apoio psicossocial e jurídico, além de medidas protetivas. Ressaltou ainda que Campinas enfrenta uma grave situação, com altos índices de feminicídios e escassez de equipamentos adequados para atender às mulheres. Por fim, manifestou confiança de que a Ministra considerará a solicitação, trazendo um importante recurso para a região no combate à violência de gênero.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=10%2F7%2F2024&txPagina=181&txSuplemento=&enviar=Pesquisar"},{"data":"2024-07-08","hora":"17:08","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado expressou a honra de representar mais de 74 mil eleitores da Região Metropolitana de Campinas (SP) no Congresso Nacional. Destacou a importância de Campinas como polo de ciência, tecnologia, educação e cidadania, e defendeu a necessidade de maior representação política na região. Comprometeu-se a contribuir para a reconstrução do País, liderada pelo Presidente Lula, focando em saúde, educação, assistência social, segurança pública, preservação ambiental e desenvolvimento sustentável. Por fim, agradeceu aos colegas de bancada e reafirmou seu compromisso com a democracia e os direitos humanos.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=9%2F7%2F2024&txPagina=24&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2024-W44","autorias":1,"votos":7,"relatorias":0,"discursos":1},{"semana":"2024-W42","autorias":1,"votos":2,"relatorias":0,"discursos":0},{"semana":"2024-W38","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W37","autorias":1,"votos":20,"relatorias":1,"discursos":0},{"semana":"2024-W35","autorias":0,"votos":1,"relatorias":1,"discursos":0},{"semana":"2024-W33","autorias":0,"votos":10,"relatorias":0,"discursos":1},{"semana":"2024-W28","autorias":1,"votos":26,"relatorias":2,"discursos":3}],"gerado_em":"2026-11-08T17:47:05Z"}