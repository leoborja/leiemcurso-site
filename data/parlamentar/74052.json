rtido":"PL","orientacao_partido":"Não","orientacao_bancada":"PL"},{"votacao_id":"2430143-57","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-10","orgao":"PLEN","voto":"Sim","partido":"PL","orientacao_partido":"Sim","orientacao_bancada":"PL"},{"votacao_id":"2430143-45","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-10","orgao":"PLEN","voto":"Sim","partido":"PL","orientacao_partido":"Sim","orientacao_bancada":"PL"},{"votacao_id":"2447901-6","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Não","partido":"PL","orientacao_partido":"Não","orientacao_bancada":"PL"},{"votacao_id":"2447439-8","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PL","orientacao_partido":"Não","orientacao_bancada":"PL"},{"votacao_id":"2399598-112","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PL","orientacao_partido":"Sim","orientacao_bancada":"PL"},{"votacao_id":"2399598-108","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Não","partido":"PL","orientacao_partido":"Não","orientacao_bancada":"PL"}],"discursos":[{"data":"2024-09-10","hora":"16:16","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado destacou uma chacina que ocorreu em Nossa Senhora Aparecida (SE), durante um campeonato de sinuca, resultando na morte de seis pessoas. Elogiou a atuação da Polícia Civil e Militar de Sergipe, destacando o trabalho do Delegado Gregório Bezerra. Em seguida, expressou preocupação com as queimadas que afetam o Brasil, especialmente nas regiões Norte e Centro-Oeste, e enfatizou a necessidade de ação das polícias para combater esses incidentes, que ele acredita serem, em grande parte, criminosos.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=11%2F9%2F2024&txPagina=72&txSuplemento=&enviar=Pesquisar"},{"data":"2024-08-15","hora":"11:32","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado destacou a importância do transporte rodoviário no Brasil, lamentando a falta de investimentos em hidrovias e ferrovias. Mencionou que o transporte rodoviário, especialmente para caminhoneiros autônomos, enfrenta dificuldades devido ao alto custo do diesel. Também ressaltou a importância do Rio São Francisco para o Nordeste e criticou a execução das obras de transposição, afirmando que poderia ter sido mais eficiente. Cobrou agilidade na construção do Canal do Xingó, essencial para resolver a crise hídrica em Sergipe e melhorar a qualidade de vida da população.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=16%2F8%2F2024&txPagina=43&txSuplemento=&enviar=Pesquisar"},{"data":"2024-07-08","hora":"17:12","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado, em seu retorno à Câmara Federal pela quarta vez, comemorou a coincidência de encontrar antigos colegas. Destacou a importância do Parlamento para defender os interesses do povo brasileiro. Ademais, refletiu sobre sua trajetória política, incluindo sua experiência como Prefeito e Deputado Estadual em Sergipe, enfatizando o compromisso com o coletivo e o País. Por fim, manifestou confiança no futuro do Brasil e reiterou o compromisso de priorizar os interesses de Sergipe e do País durante seu mandato.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=9%2F7%2F2024&txPagina=26&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2024-W44","autorias":0,"votos":6,"relatorias":0,"discursos":0},{"semana":"2024-W42","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2024-W38","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W37","autorias":0,"votos":18,"relatorias":0,"discursos":1},{"semana":"2024-W35","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2024-W33","autorias":0,"votos":10,"relatorias":0,"discursos":1},{"semana":"2024-W28","autorias":0,"votos":24,"relatorias":0,"discursos":1},{"semana":"2019-W33","autorias":0,"votos":0,"relatorias":1,"discursos":0}],"gerado_em":"2026-11-08T17:47:05Z"}