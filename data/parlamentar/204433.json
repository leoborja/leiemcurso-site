artido":"PSD","orientacao_partido":"Não","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2400758-62","proposicao_id":2400758,"sigla":"PLP 233/2023","data":"2024-04-09","orgao":"PLEN","voto":"Sim","partido":"PSD","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2406964-10","proposicao_id":2358337,"sigla":"PL 2144/2023","data":"2023-12-05","orgao":"PLEN","voto":"Sim","partido":"PSD","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2367600-49","proposicao_id":2367600,"sigla":"MPV 1177/2023","data":"2023-09-27","orgao":"PLEN","voto":"Sim","partido":"PSD","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2367600-47","proposicao_id":2367600,"sigla":"MPV 1177/2023","data":"2023-09-27","orgao":"PLEN","voto":"Sim","partido":"PSD","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2367600-45","proposicao_id":2367600,"sigla":"MPV 1177/2023","data":"2023-09-27","orgao":"PLEN","voto":"Sim","partido":"PSD","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2367600-35","proposicao_id":2367600,"sigla":"MPV 1177/2023","data":"2023-09-27","orgao":"PLEN","voto":"Não","partido":"PSD","orientacao_partido":"Não","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2367600-30","proposicao_id":2367600,"sigla":"MPV 1177/2023","data":"2023-09-27","orgao":"PLEN","voto":"Não","partido":"PSD","orientacao_partido":"Não","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2358527-8","proposicao_id":2357055,"sigla":"PL 1987/2023","data":"2023-05-09","orgao":"PLEN","voto":"Sim","partido":"PSD","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPodePsc"}],"discursos":[{"data":"2025-02-05","hora":"15:00","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado criticou o viés partidário do juiz Marcelo Bretas, destacando sua atuação durante as eleições de 2018, quando favoreceu a candidatura de Wilson Witzel e prejudicou Eduardo Paes. Além disso, ressaltou que Bretas, mesmo afastado, tem se posicionado de forma tendenciosa, especialmente nas redes sociais, ao defender os golpistas do 8 de janeiro e contrariar decisões do Supremo Tribunal Federal (STF). Ademais, informou que protocolou reclamação junto ao Conselho Nacional de Justiça (CNJ), sustentando o afastamento definitivo de Bretas da magistratura. Por fim, enfatizou a importância de proteger a democracia e alertou sobre os riscos de um juiz usar seu poder para fins políticos.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=6%2F2%2F2025&txPagina=50&txSuplemento=&enviar=Pesquisar"},{"data":"2024-04-10","hora":"16:16","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Parlamentar pediu à Casa que considere a investigação feita pela Polícia Federal para a prisão do Deputado Chiquinho Brazão, ressaltando a necessidade de combater o crime organizado. Criticou a tentativa de politizar o assunto e instou os Deputados a votarem com transparência, evitando o corporativismo. Por fim, alertou para os perigos de liberar um suspeito do homicídio da Vereadora Marielle Franco.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=11%2F4%2F2024&txPagina=68&txSuplemento=&enviar=Pesquisar"},{"data":"2023-09-26","hora":"17:48","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado destacou a importância do projeto de lei da cota de tela para o desenvolvimento da indústria do audiovisual no Brasil. Enfatizou que a cota de tela é essencial para garantir que as obras brasileiras tenham espaço no circuito exibidor, promovendo a diversidade da cultura e identidade brasileiras. Ressaltou que o setor audiovisual não apenas gera empregos e renda, mas também contribui para a construção da cidadania e democracia, refletindo a experiência civilizatória do País. O orador apelou pela rápida apreciação e votação do projeto.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=27%2F9%2F2023&txPagina=105&txSuplemento=&enviar=Pesquisar"},{"data":"2023-05-09","hora":"14:28","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"Falecimento do Deputado Federal David Miranda e da cantora Rita Lee, a rainha do rock brasileiro. Anúncio de implementação pelo Prefeito Municipal do Rio de Janeiro, Eduardo Paes, de amplo plano de investimentos na área cultural. Recriação do Ministério da Cultura pelo Presidente Luiz Inácio Lula da Silva. Anúncio de regulamentação da Lei Complementar nº 195, de 2022, (Lei Paulo Gustavo), sobre o apoio financeiro da União aos Estados, ao Distrito Federal e aos Municípios para garantia de ações emergenciais ao setor cultural.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=10%2F5%2F2023&txPagina=36&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2025-W06","autorias":0,"votos":0,"relatorias":0,"discursos":1},{"semana":"2024-W16","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W15","autorias":0,"votos":6,"relatorias":0,"discursos":1},{"semana":"2024-W14","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2023-W49","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2023-W39","autorias":0,"votos":5,"relatorias":0,"discursos":1},{"semana":"2023-W19","autorias":0,"votos":1,"relatorias":0,"discursos":1}],"gerado_em":"2026-11-08T17:47:05Z"}