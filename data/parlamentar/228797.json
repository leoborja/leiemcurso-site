o de trabalho, mas também para serem cidadãos críticos e conscientes. Apelou ao apoio dos colegas Parlamentares para construir um Tocantins e um Brasil melhores, enfatizando a necessidade de união e colaboração para alcançar grandes feitos.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=24%2F5%2F2024&txPagina=29&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2024-W38","autorias":1,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W37","autorias":0,"votos":21,"relatorias":0,"discursos":0},{"semana":"2024-W36","autorias":2,"votos":0,"relatorias":0,"discursos":0},{"semana":"2024-W35","autorias":1,"votos":2,"relatorias":1,"discursos":0},{"semana":"2024-W33","autorias":1,"votos":11,"relatorias":0,"discursos":0},{"semana":"2024-W28","autorias":1,"votos":23,"relatorias":0,"discursos":0},{"semana":"2024-W27","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W25","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W24","autorias":2,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W23","autorias":0,"votos":0,"relatorias":0,"discursos":1},{"semana":"2024-W22","autorias":0,"votos":4,"relatorias":0,"discursos":0},{"semana":"2024-W21","autorias":0,"votos":3,"relatorias":0,"discursos":1}],"gerado_em":"2026-11-08T17:47:05Z"}