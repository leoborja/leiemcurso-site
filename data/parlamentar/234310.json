ancada":"Fdr PSOL-REDE"},{"votacao_id":"2576234-41","proposicao_id":2576234,"sigla":"PLP 204/2025","data":"2025-11-03","orgao":"PLEN","voto":"Sim","partido":"REDE","orientacao_partido":null,"orientacao_bancada":"Fdr PSOL-REDE"},{"votacao_id":"2576234-34","proposicao_id":2576234,"sigla":"PLP 204/2025","data":"2025-11-03","orgao":"PLEN","voto":"Sim","partido":"REDE","orientacao_partido":"Sim","orientacao_bancada":"Fdr PSOL-REDE"}],"discursos":[{"data":"2026-03-25","hora":"15:12","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado criticou o acordo sobre minerais críticos e terras raras firmado entre o Estado de Goiás e os Estados Unidos. Afirmou que a iniciativa violaria a Constituição ao tratar de recursos minerais, que seriam bens da União, e ao envolver relações internacionais, competência do Presidente da República. Informou que o Brasil detém uma das maiores reservas globais de terras raras, essenciais para tecnologias como veículos elétricos e painéis solares, mas alertou que a simples exportação de minério bruto repetiria erros históricos. Também defendeu investimentos em processamento e inovação, citando iniciativas nacionais na área, e criticou o Governador Ronaldo Caiado por desconsiderar o desenvolvimento tecnológico interno.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/234310/discursos?dataInicio=2026-03-25&dataFim=2026-03-25"},{"data":"2026-03-18","hora":"19:00","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado esclareceu o substitutivo ao Projeto de Lei nº 6.894, de 2013, que dispõe sobre a vinculação de bolsistas de iniciação científica para ensino superior e médio, estudantes de escolas técnicas federais e prestadores de serviço militar obrigatório, ao Regime Geral de Previdência Social e dá outras providências.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=19%2F3%2F2026&txPagina=149&txSuplemento=&enviar=Pesquisar"},{"data":"2026-03-18","hora":"18:00","tipo":"PARECER","fase":"Ordem do Dia","sumario":"O Deputado proferiu parecer ao Projeto de Lei nº 6.894, de 2013, que dispõe sobre a vinculação de bolsistas de iniciação científica para ensino superior e médio, estudantes de escolas técnicas federais e prestadores de serviço militar obrigatório, ao Regime Geral de Previdência Social e dá outras providências.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=19%2F3%2F2026&txPagina=130&txSuplemento=&enviar=Pesquisar"},{"data":"2026-03-04","hora":"16:24","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":null,"url":"https://dadosabertos.camara.leg.br/api/v2/deputados/234310/discursos?dataInicio=2026-03-04&dataFim=2026-03-04"},{"data":"2026-02-25","hora":"20:24","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação do Projeto de Decreto Legislativo nº 50, de 2026, que aprova o texto do Acordo sobre a 15ª Reunião da Conferência das Partes da Convenção sobre a Conservação das Espécies Migratórias de Animais Silvestres, assinado em Nairóbi, Quênia, em 21 de dezembro de 2025.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=26%2F2%2F2026&txPagina=181&txSuplemento=&enviar=Pesquisar"},{"data":"2026-02-25","hora":"19:56","tipo":"DISCUSSÃO","fase":"Ordem do Dia","sumario":"O Deputado discutiu a Mensagem nº 112, de 2026, que trata do Acordo sobre a 15ª Reunião da Conferência das Partes da Convenção sobre a Conservação das Espécies Migratórias de Animais Silvestres, assinado em Nairóbi, Quênia, em 21 de dezembro de 2025.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=26%2F2%2F2026&txPagina=169&txSuplemento=&enviar=Pesquisar"},{"data":"2026-02-25","hora":"18:56","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação do requerimento de urgência à Mensagem nº 112, de 2026, que dispõe sobre o Acordo sobre a 15ª Reunião da Conferência das Partes da Convenção sobre a Conservação das Espécies Migratórias de Animais Silvestres, assinado em Nairóbi, Quênia, em 21 de dezembro de 2025.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=26%2F2%2F2026&txPagina=145&txSuplemento=&enviar=Pesquisar"},{"data":"2026-02-25","hora":"00:04","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação do substitutivo apresentado ao Projeto de Lei nº 278, de 2026, que altera a Lei nº 11.196, de 21 de novembro de 2005, para instituir o Regime Especial de Tributação para Serviços de Datacenter – REDATA, e a Lei nº 15.211, de 17 de setembro de 2025.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=25%2F2%2F2026&txPagina=261&txSuplemento=&enviar=Pesquisar"},{"data":"2026-02-10","hora":"19:36","tipo":"DISCUSSÃO","fase":"Ordem do Dia","sumario":"O Deputado discutiu o Projeto de Lei nº 6.133, de 2025, que cria a Universidade Federal do Esporte.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=11%2F2%2F2026&txPagina=65&txSuplemento=&enviar=Pesquisar"},{"data":"2026-02-10","hora":"18:44","tipo":"QUESTÃO DE ORDEM","fase":"Ordem do Dia","sumario":"O Deputado apresentou questão de ordem com base no art. 192 para registrar que havia se inscrito para encaminhamento e não teve a palavra concedida. Também criticou a proposta de criação da Universidade do Esporte e questionou a urgência da matéria. Afirmou que o Brasil já possuía estrutura acadêmica consolidada na área, citando universidades com destaque internacional em ensino e pesquisa esportiva. Por fim, declarou que o País figurava entre os que mais produziam ciência em diversas modalidades esportivas, defendendo melhor aproveitamento do sistema universitário existente.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=11%2F2%2F2026&txPagina=43&txSuplemento=&enviar=Pesquisar"},{"data":"2025-12-16","hora":"20:12","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado, como representante da Academia Brasileira, contestou Parlamentares que negaram evidências científicas sobre os efeitos nocivos do consumo de refrigerantes. Além disso, ressaltou que há ampla base científica e convidou os Deputados a lerem o estudo da pesquisadora brasileira Laura Lara Castor publicado na revista Nature Medicine, o qual relaciona bebidas adoçadas a 2 milhões de casos de diabetes tipo 2 no mundo.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=17%2F12%2F2025&txPagina=207&txSuplemento=&enviar=Pesquisar"},{"data":"2025-12-15","hora":"23:44","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação do Substitutivo do Senado Federal oferecido ao Projeto de Lei Complementar nº 108, de 2024, que institui o Comitê Gestor do Imposto sobre Bens e Serviços (CGIBS), dispõe sobre o processo administrativo tributário relativo ao lançamento de ofício do Imposto sobre Bens e Serviços (IBS), sobre a distribuição para os entes federativos do produto da arrecadação do IBS, e sobre o Imposto sobre Transmissão Causa mortis e Doação de Quaisquer Bens ou Direitos (ITCMD), e dá outras providências. Aproveitou para esclarecer que comparações com os Estados Unidos precisam ser feitas com precisão, já que naquele país, Estados e cidades têm autonomia tributária e adotam a chamada soda tax, assim como ocorre na maior parte dos países europeus, que também aplicam impostos específicos sobre refrigerantes como instrumento de política pública de saúde.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=16%2F12%2F2025&txPagina=134&txSuplemento=&enviar=Pesquisar"},{"data":"2025-12-15","hora":"20:36","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado afirmou que as chuvas intensas registradas em São Paulo evidenciaram as consequências de desconsiderar a ciência na formulação de políticas públicas. Relatou visita ao Cemaden, em São José dos Campos (SP), e destacou a capacidade técnica do centro para prever desastres naturais. Também informou que o órgão tentou firmar acordo com a Enel para instalação de radares Doppler capazes de prever ventos, proposta que não foi aceita. Ao final, citou dados do Cemaden sobre o agravamento da seca no Nordeste e no Matopiba, com impactos para a produção agrícola.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=16%2F12%2F2025&txPagina=44&txSuplemento=&enviar=Pesquisar"},{"data":"2025-12-10","hora":"03:04","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação do § 9° do Art. 126 da Lei nº 7.210, de 1984, constante do art. 1º do substitutivo apresentado ao Projeto de lei nº 2162, de 2023, que dispõe sobre a dosimetria das penas.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=10%2F12%2F2025&txPagina=352&txSuplemento=&enviar=Pesquisar"},{"data":"2025-12-10","hora":"01:24","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação do requerimento de encerramento da discussão e do encaminhamento do Projeto de Lei nº 2.162, de 2023, que dispõe sobre a dosimetria das penas e concede anistia aos participantes das manifestações reivindicatórias de motivação política ocorridas entre o dia 30 de outubro de 2022 e o dia de entrada em vigor desta Lei.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/234310/discursos?dataInicio=2025-12-10&dataFim=2025-12-10"},{"data":"2025-12-02","hora":"21:08","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado relembrou a acusação do ex-Presidente Bolsonaro de que teria mentido sobre dados do Instituto Nacional de Pesquisas Espaciais (Inpe) e estaria a serviço de instituição internacional. Ademais, afirmou que desafiou publicamente o ex-Presidente a comprovar suas acusações, mas ele recusou. Por fim, destacou que foi demitido um mês após o episódio.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=3%2F12%2F2025&txPagina=125&txSuplemento=&enviar=Pesquisar"},{"data":"2025-12-02","hora":"19:00","tipo":"DISCUSSÃO","fase":"Ordem do Dia","sumario":"O Deputado discutiu a Medida Provisória nº 1.308, de 2025, que dispõe sobre o licenciamento ambiental especial, visando à consecução eficiente e eficaz de atividades e empreendimentos estratégicos, nos termos que especifica.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=3%2F12%2F2025&txPagina=75&txSuplemento=&enviar=Pesquisar"},{"data":"2025-12-02","hora":"17:28","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado comentou a indicação do Dr. Jorge Messias ao Supremo Tribunal Federal e destacou sua atuação na gestão da Advocacia-Geral da União (AGU), marcada por modernização institucional, redução de litígios e fortalecimento da defesa constitucional. Relatou que o indicado conheceu profundamente a gestão de ciência e tecnologia, garantindo segurança jurídica às instituições do setor com a criação de estruturas específicas. Mencionou ainda avanços na área ambiental, como a criação da Procuradoria Nacional da União para a Defesa do Clima e apoio a ações emergenciais. Afirmou que Messias mostrou perfil técnico, conciliador, inovador e comprometido com a democracia.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=3%2F12%2F2025&txPagina=38&txSuplemento=&enviar=Pesquisar"},{"data":"2025-11-27","hora":"14:17","tipo":"ENCAMINHAMENTO DE VOTAÇÃO","fase":"Ordem do Dia","sumario":"O Deputado encaminhou a votação dos itens do Veto Parcial nº 29, de 2025, aposto ao Projeto de Lei nº 2.159, de 2021, que dispõe sobre o licenciamento ambiental. Na oportunidade, lembrou que foi Diretor do Instituto Nacional de Pesquisas Espaciais (INPE) e afirmou que a proposição incorpora mecanismos que fragilizam o controle ambiental, citando como exemplo o uso da autodeclaração para dispensar licenciamento em atividades do agronegócio.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=J&Datain=28%2F11%2F2025&txPagina=60&txSuplemento=&enviar=Pesquisar"},{"data":"2025-11-11","hora":"19:24","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado manifestou-se sobre os Projetos de Lei nº 238, de 2019, e nº 1.496, de 2021. Argumentou que a coleta de material genético de todos os que ingressam em uma delegacia representa grave ameaça à privacidade e à segurança individual, e alertou para os riscos do uso indevido desses dados por meio da inteligência artificial. Por fim, ressaltou que a coleta poderia ser aceitável apenas em casos de pessoas já condenadas e sob custódia do Estado, e reiterou que a extensão indiscriminada da medida era inconstitucional.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=12%2F11%2F2025&txPagina=176&txSuplemento=&enviar=Pesquisar"},{"data":"2025-11-11","hora":"19:00","tipo":"COMO LÍDER","fase":"Ordem do Dia","sumario":"O Deputado afirmou que o debate sobre o uso medicinal da Cannabis tem origem histórica e científica sólida, citando pesquisas desenvolvidas há milênios e avanços recentes liderados por especialistas como Raphael Mechoulam, Elisaldo Carlini e Antônio Zuardi. Destacou que o Brasil possui produção científica de alta qualidade na área de canabinoides e lembrou que o STJ autorizou, em 2023, a importação de sementes e o cultivo de cânhamo industrial, ainda sem regulamentação pela Anvisa. Por fim, defendeu que o tema seja apreciado pelo Congresso, como sugerido pelo Ministro Paulo Teixeira, e afirmou que o País não pode ignorar evidências científicas ao tratar do assunto.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=12%2F11%2F2025&txPagina=166&txSuplemento=&enviar=Pesquisar"},{"data":"2025-11-04","hora":"20:44","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação do requerimento de encerramento da discussão do Projeto de Lei nº 8.889, de 2017, que dispõe sobre a provisão de conteúdo audiovisual por demanda (CAvD) e dá outras providências.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=5%2F11%2F2025&txPagina=295&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2026-W14","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W13","autorias":3,"votos":6,"relatorias":0,"discursos":1},{"semana":"2026-W12","autorias":0,"votos":9,"relatorias":0,"discursos":2},{"semana":"2026-W11","autorias":0,"votos":4,"relatorias":0,"discursos":0},{"semana":"2026-W10","autorias":1,"votos":10,"relatorias":0,"discursos":1},{"semana":"2026-W09","autorias":0,"votos":1,"relatorias":0,"discursos":4},{"semana":"2026-W07","autorias":0,"votos":10,"relatorias":0,"discursos":2},{"semana":"2026-W06","autorias":0,"votos":3,"relatorias":0,"discursos":0},{"semana":"2025-W51","autorias":1,"votos":17,"relatorias":0,"discursos":3},{"semana":"2025-W50","autorias":1,"votos":15,"relatorias":0,"discursos":2},{"semana":"2025-W49","autorias":0,"votos":2,"relatorias":1,"discursos":3},{"semana":"2025-W48","autorias":0,"votos":4,"relatorias":0,"discursos":1},{"semana":"2025-W47","autorias":0,"votos":9,"relatorias":0,"discursos":0},{"semana":"2025-W46","autorias":0,"votos":3,"relatorias":0,"discursos":2},{"semana":"2025-W45","autorias":0,"votos":16,"relatorias":0,"discursos":1}],"gerado_em":"2026-11-08T17:47:05Z"}