o":"PDT","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2430143-45","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-10","orgao":"PLEN","voto":"Não","partido":"PDT","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2447901-6","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PDT","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2447439-8","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PDT","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2399598-112","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PDT","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2399598-108","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PDT","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2441271-7","proposicao_id":2434970,"sigla":"PL 1956/2024","data":"2024-06-19","orgao":"PLEN","voto":"Sim","partido":"PDT","orientacao_partido":null,"orientacao_bancada":null}],"discursos":[{"data":"2024-10-08","hora":"17:28","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada expressou sua gratidão ao concluir quatro meses de mandato, ressaltando seu compromisso com o povo da Baixada Maranhense e destacando propostas legislativas significativas. Mencionou a criação da Política Nacional de Saúde na Escola, que visa oferecer educação de qualidade com cuidados de saúde para crianças e adolescentes. Também propôs a conscientização sobre a dupla excepcionalidade, combate ao capacitismo e deduções no Imposto de Renda para consultas com enfermeiros. Além disso, destacou a articulação de recursos superiores a 2 milhões de reais para a saúde em sua cidade e a implementação do Programa Alô, Bebê.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=9%2F10%2F2024&txPagina=90&txSuplemento=&enviar=Pesquisar"},{"data":"2024-09-10","hora":"16:24","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada destacou a importância da valorização dos profissionais técnicos e administrativos da educação básica, defendendo o Projeto de Lei nº 2.531, de 2021. Ressaltou que o projeto estabelece um piso salarial de R$ 2.164,68 para jornadas de até 40 horas semanais, visando corrigir a negligência histórica sofrida por esses servidores. Ademais, mencionou um encontro com representantes do sindicato de trabalhadores da educação do Maranhão, que evidenciaram a necessidade da aprovação da proposta. Solicitou a inclusão imediata da propositura na Ordem do Dia e apelou pela votação do requerimento de urgência, reforçando a relevância desses profissionais para o bom funcionamento das escolas.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=11%2F9%2F2024&txPagina=73&txSuplemento=&enviar=Pesquisar"},{"data":"2024-08-27","hora":"15:40","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada comemorou o aniversário de 168 anos de Pinheiro (MA), sua cidade natal, destacando os avanços recentes sob a gestão do Prefeito Luciano Genésio, seu irmão. Elogiou o crescimento de Pinheiro como polo de inovação e empreendedorismo, mencionando o prêmio Selo Diamante do SEBRAE. Também destacou os avanços na saúde, como o combate à COVID-19, o Programa Municipal Alô Bebê, o Centro de Hemodiálise e o Hospital Dr. Antonio Dino. Informou que, na educação, a cidade reformou mais de cem escolas e se tornou referência com o curso de Medicina da UFMA e o curso de Direito na UEMA.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=28%2F8%2F2024&txPagina=57&txSuplemento=&enviar=Pesquisar"},{"data":"2024-07-02","hora":"18:36","tipo":"PARECER","fase":"Ordem do Dia","sumario":"A Deputada proferiu parecer ao Projeto de Lei nº 3.777, de 2023, que dispõe sobre indenização às vítimas de crimes contra a liberdade sexual.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=3%2F7%2F2024&txPagina=129&txSuplemento=&enviar=Pesquisar"},{"data":"2024-07-02","hora":"16:56","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada expressou homenagem ao Pastor Abraão dos Santos Serra, da cidade de Pinheiro (MA). Informou que o Pastor, conhecido por seu papel como líder espiritual e formador de líderes, tem 60 anos de ministério, sendo 57 deles como pastor ordenado, e pastoreia na Assembleia Deus em Pinheiro há 42 anos. Além disso, relembrou o apoio caloroso recebido durante sua campanha eleitoral nas congregações da Assembleia de Deus, destacando a importância do Pastor Abraão para a comunidade.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=3%2F7%2F2024&txPagina=87&txSuplemento=&enviar=Pesquisar"},{"data":"2024-06-26","hora":"15:12","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada celebrou a inauguração do Hospital do Câncer Dr. Antonio Dino em Pinheiro (MA), destacando a importância do diagnóstico precoce no tratamento oncológico. Informou que o hospital, fruto de emendas da bancada federal e da articulação do Senador Weverton Rocha, descentraliza o atendimento oncológico na Baixada Maranhense e no Litoral Ocidental. Agradeceu à bancada maranhense, ao Prefeito Luciano Genésio pela doação do terreno e à Câmara dos Vereadores de Pinheiro. Por fim, reforçou seu compromisso com a melhoria da saúde pública e o bem-estar do povo maranhense, especialmente das regiões mais carente.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=27%2F6%2F2024&txPagina=41&txSuplemento=&enviar=Pesquisar"},{"data":"2024-06-18","hora":"15:20","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada expressou sua gratidão e honra ao assumir como a primeira mulher da Baixada Maranhense a ocupar uma cadeira na Casa. Destacou sua determinação em representar não apenas sua região, mas todas as vozes que clamam por justiça, igualdade e progresso no Maranhão. Prometeu dedicar seus quatro meses de mandato para plantar sementes de transformação e justiça social, buscando construir um futuro melhor e mais digno para as famílias.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=19%2F6%2F2024&txPagina=60&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2024-W42","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W41","autorias":0,"votos":0,"relatorias":0,"discursos":1},{"semana":"2024-W38","autorias":1,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W37","autorias":2,"votos":14,"relatorias":0,"discursos":1},{"semana":"2024-W36","autorias":0,"votos":0,"relatorias":1,"discursos":0},{"semana":"2024-W35","autorias":0,"votos":3,"relatorias":0,"discursos":1},{"semana":"2024-W34","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2024-W33","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W28","autorias":2,"votos":23,"relatorias":1,"discursos":0},{"semana":"2024-W27","autorias":0,"votos":0,"relatorias":0,"discursos":2},{"semana":"2024-W26","autorias":0,"votos":0,"relatorias":0,"discursos":1},{"semana":"2024-W25","autorias":0,"votos":1,"relatorias":1,"discursos":1}],"gerado_em":"2026-11-08T17:47:05Z"}