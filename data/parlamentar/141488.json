igla":"PL 3025/2023","data":"2026-04-22","orgao":"PLEN","voto":"Não","partido":"PT","orientacao_partido":"Não","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2368697-43","proposicao_id":2368697,"sigla":"PL 3025/2023","data":"2026-04-22","orgao":"PLEN","voto":"Não","partido":"PT","orientacao_partido":"Não","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2368697-38","proposicao_id":2368697,"sigla":"PL 3025/2023","data":"2026-04-22","orgao":"PLEN","voto":"Não","partido":"PT","orientacao_partido":"Não","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2608575-64","proposicao_id":2608575,"sigla":"PLP 55/2026","data":"2026-04-15","orgao":"PLEN","voto":"Sim","partido":"PT","orientacao_partido":"Sim","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2600708-7","proposicao_id":2461363,"sigla":"PL 3838/2024","data":"2026-04-15","orgao":"PLEN","voto":"Sim","partido":"PT","orientacao_partido":"Sim","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2581700-31","proposicao_id":2581700,"sigla":"MPV 1323/2025","data":"2026-04-07","orgao":"PLEN","voto":"Sim","partido":"PT","orientacao_partido":"Sim","orientacao_bancada":"Fdr PT-PCdoB-PV"},{"votacao_id":"2503998-70","proposicao_id":2503998,"sigla":"PLP 109/2025","data":"2026-04-07","orgao":"PLEN","voto":"Não","partido":"PT","orientacao_partido":"Não","orientacao_bancada":"Fdr PT-PCdoB-PV"}],"discursos":[{"data":"2026-10-14","hora":"18:12","tipo":"DISCUSSÃO","fase":"Ordem do Dia","sumario":null,"url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=15%2F10%2F2026&txPagina=&txSuplemento=&enviar=Pesquisar"},{"data":"2026-07-14","hora":"17:12","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado homenageou Valmir Rodrigues Chaves, conhecido como Bill do Movimento dos Trabalhadores Rurais Sem-Terra (MST), destacando a atuação na luta pela reforma agrária, pela agricultura familiar e pela organização dos trabalhadores do campo. Além disso, relembrou a participação na consolidação do assentamento Gleba 15 de Novembro, a defesa da agroecologia e da preservação ambiental, bem como a resistência diante da criminalização dos movimentos sociais. Por fim, manifestou solidariedade aos familiares, aos militantes do MST e às famílias assentadas, afirmando que o legado de Bill permaneceria como referência na busca por justiça social.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/141488/discursos?dataInicio=2026-07-14&dataFim=2026-07-14"},{"data":"2026-06-16","hora":"20:08","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado parabenizou o Parlamentar Lafayette Andrade pelo voto equilibrado do Projeto de Lei Complementar nº 337, de 2017, apresentado no plenário. Agradeceu o acolhimento das preocupações que resultaram em melhorias e aperfeiçoamentos na matéria aprovada na CCJ. Além disso, destacou a tradição da família Andrade, presente no Parlamento desde 1822, e afirmou que Lafayette representa essa contribuição histórica para o progresso do País.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/141488/discursos?dataInicio=2026-06-16&dataFim=2026-06-16"},{"data":"2026-06-16","hora":"20:04","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação da subemenda substitutiva oferecida ao Projeto de Lei Complementar nº 337, de 2017, que altera a Lei Complementar nº 73, de 10 de fevereiro de 1993, que institui a Lei Orgânica da Advocacia-Geral da União.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/141488/discursos?dataInicio=2026-06-16&dataFim=2026-06-16"},{"data":"2026-06-16","hora":"19:56","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação da subemenda substitutiva oferecida ao Projeto de Lei Complementar nº 337, de 2017, que altera a Lei Complementar nº 73, de 10 de fevereiro de 1993, que institui a Lei Orgânica da Advocacia-Geral da União.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/141488/discursos?dataInicio=2026-06-16&dataFim=2026-06-16"},{"data":"2026-05-27","hora":"15:20","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado defendeu a redução da jornada de trabalho de 44 para 40 horas semanais e o fim do turno seis por um, afirmando que a medida beneficiaria jovens e mulheres trabalhadoras. Associou as propostas ao Governo do Presidente Lula, citando avanços como o melhor Índice de Desenvolvimento Humano (IDH) e o maior salário mínimo da história do País. Em seguida, criticou gestões anteriores por medidas que enfraqueceram sindicatos e reduziram o poder de compra dos trabalhadores. Por fim, sustentou que a mudança geraria mais empregos, fortaleceria direitos trabalhistas e contribuiria para o desenvolvimento econômico e tecnológico do País.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=28%2F7%2F2026&txPagina=96&txSuplemento=&enviar=Pesquisar"},{"data":"2024-08-12","hora":"10:40","tipo":"HOMENAGEM","fase":"Homenagem","sumario":"O Ministro do Desenvolvimento Agrário e Agricultura Familiar, Sr. Paulo Teixeira, discursou na sessão solene do Congresso Nacional em homenagem aos 40 anos do Movimento de Mulheres Camponesas. Enalteceu a liderança das mulheres no campo e destacou as políticas do Governo Lula voltadas para o fortalecimento das mulheres, como o Programa de Aquisição de Alimentos (PAA), o PRONAF Mulher e os Quintais Produtivos. Além disso, ressaltou a importância das mulheres na soberania alimentar do País e a necessidade de uma reeducação alimentar, criticando o consumo de ultraprocessados e agrotóxicos. Finalizou parabenizando as mulheres pela luta e contribuição para a alimentação e sustento do povo brasileiro.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=J&Datain=15%2F8%2F2024&txPagina=10&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2026-W44","autorias":2,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W42","autorias":0,"votos":2,"relatorias":0,"discursos":1},{"semana":"2026-W36","autorias":1,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W33","autorias":3,"votos":5,"relatorias":0,"discursos":0},{"semana":"2026-W32","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W31","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W30","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W29","autorias":0,"votos":1,"relatorias":0,"discursos":1},{"semana":"2026-W28","autorias":1,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W27","autorias":1,"votos":3,"relatorias":0,"discursos":0},{"semana":"2026-W26","autorias":3,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W25","autorias":0,"votos":3,"relatorias":0,"discursos":3},{"semana":"2026-W24","autorias":2,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W23","autorias":1,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W22","autorias":1,"votos":8,"relatorias":0,"discursos":1},{"semana":"2026-W21","autorias":0,"votos":6,"relatorias":0,"discursos":0},{"semana":"2026-W20","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W19","autorias":0,"votos":1,"relatorias":1,"discursos":0},{"semana":"2026-W18","autorias":1,"votos":2,"relatorias":0,"discursos":0},{"semana":"2026-W17","autorias":0,"votos":5,"relatorias":0,"discursos":0},{"semana":"2026-W16","autorias":2,"votos":2,"relatorias":0,"discursos":0},{"semana":"2026-W15","autorias":1,"votos":2,"relatorias":0,"discursos":0},{"semana":"2024-W33","autorias":0,"votos":0,"relatorias":0,"discursos":1},{"semana":"2023-W05","autorias":1,"votos":0,"relatorias":0,"discursos":0}],"gerado_em":"2026-11-08T17:47:05Z"}