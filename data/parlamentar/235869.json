2","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":"Não","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2368697-43","proposicao_id":2368697,"sigla":"PL 3025/2023","data":"2026-04-22","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":"Não","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2368697-38","proposicao_id":2368697,"sigla":"PL 3025/2023","data":"2026-04-22","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":"Não","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2608575-64","proposicao_id":2608575,"sigla":"PLP 55/2026","data":"2026-04-15","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2600708-7","proposicao_id":2461363,"sigla":"PL 3838/2024","data":"2026-04-15","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."},{"votacao_id":"2578968-7","proposicao_id":2426763,"sigla":"PL 1248/2024","data":"2026-04-15","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":"Sim","orientacao_bancada":"Bl UniPpPsd..."}],"discursos":[{"data":"2026-08-11","hora":"16:56","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado comunicou o encerramento de seu mandato como Deputado Federal e o retorno ao cargo de Vereador em Manaus (AM). Ademais, ressaltou a importância da representação do Amazonas nas decisões nacionais e defendeu que as particularidades do Estado sejam consideradas na formulação de políticas públicas. Por fim, destacou que a experiência adquirida no Parlamento contribuirá para sua atuação em Manaus (AM) e salientou a importância do Poder Legislativo municipal para atender às necessidades cotidianas da população.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/235869/discursos?dataInicio=2026-08-11&dataFim=2026-08-11"},{"data":"2026-05-07","hora":"10:28","tipo":"PARECER","fase":"Ordem do Dia","sumario":"O Deputado proferiu parecer ao Projeto de Lei nº 6.601, de 2025, que dispõe sobre a regulamentação da profissão de Trabalhador em Refeições Coletivas e dá outras providências.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=8%2F5%2F2026&txPagina=27&txSuplemento=&enviar=Pesquisar"},{"data":"2026-02-25","hora":"14:40","tipo":"PELA ORDEM","fase":"Breves Comunicações","sumario":"O Deputado apoiou a manifestação sobre a cacauicultura baiana e defendeu a revogação da Instrução Normativa 125, relacionada à importação de amêndoas de cacau. Argumentou que a suspensão temporária não é suficiente e pediu o fim definitivo da entrada do produto proveniente de países africanos, como a Costa do Marfim. Também afirmou ter dialogado com o Ministro da Agricultura, Carlos Fávaro, e destacou que a medida é necessária para proteger produtores nacionais, evitar prejuízos econômicos e garantir geração de emprego e renda na Bahia e em outras regiões produtoras do País.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=26%2F2%2F2026&txPagina=51&txSuplemento=&enviar=Pesquisar"},{"data":"2025-10-30","hora":"15:32","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado fez a leitura da justificativa de Emenda à Medida Provisória nº 1.304, 2025, que altera legislações relacionadas ao setor energético e ao mercado de gás natural.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=31%2F10%2F2025&txPagina=94&txSuplemento=&enviar=Pesquisar"},{"data":"2024-02-27","hora":"21:10","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado expressou seu respeito pelo Deputado Glauber Braga, mas ressaltou que o colega não estudou o Projeto de lei n° 4.831, de 2023. Ele destacou a ineficiência das distribuidoras de energia elétrica, como Enel e Light, no Estado do Rio de Janeiro e em outras regiões do país. Convidou Glauber para discutir a questão detalhadamente, enfatizando a oposição às distribuidoras ineficientes e a obrigação do Congresso Nacional em não permitir a renovação de concessões dessas empresas.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=28%2F2%2F2024&txPagina=136&txSuplemento=&enviar=Pesquisar"},{"data":"2024-02-27","hora":"20:50","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"O Deputado orientou a bancada na votação do Requerimento de urgência para apreciação do Projeto de lei ordinária nº 4.831, de 2023, que altera a Lei nº 9.074, de 7 de julho de 1995 e a Lei no 10.848, de 15 de março de 2004, referentes a concessões de serviço público de distribuição de energia elétrica.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=28%2F2%2F2024&txPagina=129&txSuplemento=&enviar=Pesquisar"},{"data":"2023-03-22","hora":"21:52","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"Contrariedade à decisão do Comitê de Política Monetária - COPOM, do Banco Central do Brasil, de manutenção da taxa básica de juros, a Taxa SELIC em 13,75% ao ano.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=23%2F3%2F2023&txPagina=185&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2026-W33","autorias":0,"votos":0,"relatorias":0,"discursos":1},{"semana":"2026-W29","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W28","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W27","autorias":0,"votos":3,"relatorias":0,"discursos":0},{"semana":"2026-W25","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2026-W23","autorias":0,"votos":1,"relatorias":1,"discursos":0},{"semana":"2026-W22","autorias":0,"votos":9,"relatorias":0,"discursos":0},{"semana":"2026-W21","autorias":2,"votos":7,"relatorias":0,"discursos":0},{"semana":"2026-W20",