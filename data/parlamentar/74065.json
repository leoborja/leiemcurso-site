-9","proposicao_id":2374540,"sigla":"PL 3640/2023","data":"2025-10-22","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2571484-12","proposicao_id":2374540,"sigla":"PL 3640/2023","data":"2025-10-22","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2438687-76","proposicao_id":2438687,"sigla":"PL 2225/2024","data":"2025-10-15","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2438687-71","proposicao_id":2438687,"sigla":"PL 2225/2024","data":"2025-10-15","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2501358-48","proposicao_id":2501358,"sigla":"PL 1924/2025","data":"2025-10-14","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2501358-37","proposicao_id":2501358,"sigla":"PL 1924/2025","data":"2025-10-14","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null}],"discursos":[{"data":"2025-10-15","hora":"16:32","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada comemorou o Dia do Professor, destacando a importância dos educadores na transformação de vidas e no desenvolvimento do Brasil, com atenção especial aos profissionais do Amapá. Mencionou a comenda “Governadores pela Alfabetização das Crianças na Idade Certa”, concedida ao Estado pelo avanço na alfabetização infantil, e enfatizou o papel coletivo de professores, servidores e autoridades na conquista. Também homenageou a professora Gentila Nobre, do Município de Santana (AP), falecida aos 104 anos, reconhecendo sua dedicação à educação. Concluiu saudando colegas e familiares, ressaltando que o aprendizado e o crescimento dependem da presença e do compromisso dos professores.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/74065/discursos?dataInicio=2025-10-15&dataFim=2025-10-15"},{"data":"2025-10-09","hora":"12:12","tipo":"PELA ORDEM","fase":"Breves Comunicações","sumario":"A Deputada celebrou seu retorno à Câmara após cinco mandatos, destacando sua trajetória voltada à assistência social e à defesa da família. Lembrou conquistas como a licença-maternidade para mães adotivas e a criação da Lei Orgânica da Assistência Social (LOAS), que estruturou o Sistema Único de Assistência Social (SUAS). Ao reassumir o mandato durante a licença da Deputada Aline Gurgel, afirmou compromisso com o desenvolvimento sustentável do Amapá e com políticas de saúde mental e valorização da vida. Ademais, anunciou foco no fortalecimento do Programa Saúde na Escola (PSE) e no incentivo ao esporte como ferramenta social. Por fim, reiterou apoio à exploração de petróleo no Amapá, aliando economia e preservação ambiental.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=10%2F10%2F2025&txPagina=61&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2026-W13","autorias":0,"votos":4,"relatorias":0,"discursos":0},{"semana":"2026-W12","autorias":0,"votos":9,"relatorias":0,"discursos":0},{"semana":"2026-W11","autorias":0,"votos":3,"relatorias":1,"discursos":0},{"semana":"2026-W10","autorias":0,"votos":10,"relatorias":0,"discursos":0},{"semana":"2026-W09","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2026-W07","autorias":0,"votos":11,"relatorias":0,"discursos":0},{"semana":"2026-W06","autorias":0,"votos":3,"relatorias":1,"discursos":0},{"semana":"2025-W51","autorias":0,"votos":18,"relatorias":0,"discursos":0},{"semana":"2025-W47","autorias":0,"votos":9,"relatorias":0,"discursos":0},{"semana":"2025-W46","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2025-W45","autorias":0,"votos":19,"relatorias":0,"discursos":0},{"semana":"2025-W44","autorias":0,"votos":10,"relatorias":0,"di