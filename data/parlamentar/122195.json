":"2430143-57","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-10","orgao":"PLEN","voto":"Não","partido":"PODE","orientacao_partido":"Não","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2430143-45","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-10","orgao":"PLEN","voto":"Não","partido":"PODE","orientacao_partido":"Não","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2447901-6","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PODE","orientacao_partido":"Não","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2447439-8","proposicao_id":2430143,"sigla":"PLP 68/2024","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PODE","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2399598-112","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PODE","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2399598-108","proposicao_id":2399598,"sigla":"PL 5230/2023","data":"2024-07-09","orgao":"PLEN","voto":"Sim","partido":"PODE","orientacao_partido":"Não","orientacao_bancada":"Bl MdbPsdRepPode"},{"votacao_id":"2441271-7","proposicao_id":2434970,"sigla":"PL 1956/2024","data":"2024-06-19","orgao":"PLEN","voto":"Sim","partido":"PODE","orientacao_partido":"Sim","orientacao_bancada":"Bl MdbPsdRepPode"}],"discursos":[{"data":"2026-08-11","hora":"17:08","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado defendeu o aumento do volume de água destinado à Paraíba por meio do Projeto de Integração do Rio São Francisco, por considerar insuficientes os cerca de 5,5 metros cúbicos por segundo atualmente disponibilizados ao Estado. Além disso, destacou que os canais possuem capacidade para transportar volume superior ao autorizado pela Agência Nacional de Águas e Saneamento Básico — ANA e alertou para os impactos de novos fenômenos climáticos, especialmente do El Niño, sobre o Sertão paraibano. Ademais, ressaltou que a Agência Executiva de Gestão das Águas do Estado da Paraíba — AESA deverá apresentar à ANA novo plano de operação para distribuição das águas entre os eixos norte e leste. Por fim, reivindicou uma articulação entre os Estados beneficiados pela transposição para ampliar a vazão, sem comprometer a preservação do Rio São Francisco.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/122195/discursos?dataInicio=2026-08-11&dataFim=2026-08-11"},{"data":"2026-07-15","hora":"11:44","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado apresentou as prioridades para o mandato de 4 meses, abordando temas que considerou urgentes para a Paraíba, o Brasil e o planeta. Tratou da transição demográfica e da necessidade de adaptações infraestruturais, legais e socioeconômicas para uma população em envelhecimento, defendendo a permanência dos idosos no mercado de trabalho. Abordou a segurança hídrica da Paraíba — Estado com o pior balanço hídrico do País —, cobrando a ampliação dos projetos de transposição do Rio São Francisco e o acesso à água tratada para um terço da população ainda desatendida. Além disso, propôs a criação da \"emenda popular\", mecanismo pelo qual a população das macrorregiões paraibanas definiria a destinação dos recursos de emendas parlamentares. Por fim, defendeu a construção de um modelo regulatório nacional próprio para as novas tecnologias, rejeitando a adoção automática dos marcos regulatórios dos Estados Unidos e da China.","url":"https://dadosabertos.camara.leg.br/api/v2/deputados/122195/discursos?dataInicio=2026-07-15&dataFim=2026-07-15"},{"data":"2024-09-09","hora":"19:24","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado expressou sua preocupação com o desinteresse da sociedade brasileira pelo processo político-eleitoral. Destacou que mudanças constantes nas regras eleitorais transformaram as campanhas em algo quase secreto e silente. Defendeu a necessidade de reverter essa situação por meio de um exame de consciência e de revisão de normas, como a redução do tempo de campanha, para revitalizar o interesse e a participação cidadã. Ressaltou que a interação direta entre eleitores e candidatos é crucial e deve ser preservada para reengajar a população na democracia.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=10%2F9%2F2024&txPagina=65&txSuplemento=&enviar=Pesquisar"},{"data":"2024-08-26","hora":"17:36","tipo":"COMO LÍDER","fase":"Breves Comunicações","sumario":"O Deputado abordou a situação atual do sistema previdenciário brasileiro, destacando a importância de distinguir entre a gestão do Instituto Nacional do Seguro Social (INSS) e a sustentabilidade do sistema a longo prazo. Além disso, elogiou a incorporação de novas tecnologias e o combate às fraudes no INSS, mas expressou preocupação com a falta de reconhecimento dos servidores como categoria típica de Estado. Também alertou para os desafios futuros da Previdência, devido à mudança demográfica e à automação, enfatizando a necessidade de fortalecer sistemas complementares e criar um fundo de transição para evitar uma crise futura.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=27%2F8%2F2024&txPagina=35&txSuplemento=&enviar=Pesquisar"},{"data":"2024-08-12","hora":"17:44","tipo":"COMO LÍDER","fase":"Breves Comunicações","sumario":"O Deputado destacou a importância de o Congresso Nacional se debruçar sobre os impactos das novas tecnologias, como a biotecnologia, inteligência artificial e computação quântica, nas relações sociais e econômicas. Ele enfatizou a necessidade de encontrar um equilíbrio entre a liberdade total e a rejeição às inovações. Nesse contexto, apresentou o Projeto de Resolução nº 42, de 2021, sobre a criação do Observatório de Inovação Tecnológica, destinado a auxiliar o Parlamento no entendimento e regulação desses temas. Ressaltou que o Brasil não pode ignorar as transformações em curso e deve agir com responsabilidade para evitar problemas futuros.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=13%2F8%2F2024&txPagina=38&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2026-W42","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2026-W36","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2026-W33","autorias":0,"votos":2,"relatorias":0,"discursos":1},{"semana":"2026-W29","autorias":0,"votos":0,"relatorias":0,"discursos":1},{"semana":"2024-W42","autorias":2,"votos":0,"relatorias":0,"discursos":0},{"semana":"2024-W41","autorias":2,"votos":0,"relatorias":2,"discursos":0},{"semana":"2024-W39","autorias":2,"votos":0,"relatorias":0,"discursos":0},{"semana":"2024-W38","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W37","autorias":2,"votos":14,"relatorias":0,"discursos":1},{"semana":"2024-W35","autorias":2,"votos":2,"relatorias":3,"discursos":1},{"semana":"2024-W33","autorias":0,"votos":9,"relatorias":0,"discursos":1},{"semana":"2024-W30","autorias":2,"votos":0,"relatorias":0,"discursos":0},{"semana":"2024-W28","autorias":0,"votos":26,"relatorias":0,"discursos":0},{"semana":"2024-W27","autorias":1,"votos":0,"relatorias":1,"discursos":0},{"semana":"2024-W25","autorias":0,"votos":1,"relatorias":0,"discursos":0}],"gerado_em":"2026-11-08T17:47:05Z"}