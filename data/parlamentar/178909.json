cao_id":"1197773-99","proposicao_id":1197773,"sigla":"PL 4015/2023","data":"2023-08-09","orgao":"PLEN","voto":"Não","partido":"UNIÃO","orientacao_partido":"Liberado","orientacao_bancada":"Bl UniPpFdrPsdbCid..."}],"discursos":[{"data":"2024-10-29","hora":"15:48","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado registrou a presença do Prefeito de Ourém, Roberto Uchoa, e do Prefeito eleito, Junhão, no plenário da Câmara. Ressaltou o papel dos Prefeitos na articulação política e no desenvolvimento de Ourém e do Estado do Pará, destacando o crescimento econômico local e a próxima realização da Conferência das Partes da Convenção-Quadro das Nações Unidas sobre Mudança de Clima (COP) na região, em 2025. Enfatizou a importância da parceria com o Governador Helder Barbalho e com a bancada paraense para fortalecer o Pará, valorizando a Amazônia como destino turístico e cultural. Ao concluir, parabenizou os Prefeitos e reiterou o apoio da Câmara aos avanços no Estado.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=30%2F10%2F2024&txPagina=70&txSuplemento=&enviar=Pesquisar"},{"data":"2024-05-22","hora":"16:28","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado registrou a presença dos Prefeitos Tarrafa, de Curuçá (PA), e Egilasio, de Inhangapi (PA), juntamente com os Vereadores Alessandre, de Ourém (PA), Dani, Fábio, Hítalo, Vanderson e Márcio, todos de Curuçá, além de seu Chefe de Gabinete Júlio. Destacou a importância desses líderes municipais que trabalham para fortalecer suas cidades e contribuir para o desenvolvimento do Estado do Pará e do país.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=23%2F5%2F2024&txPagina=81&txSuplemento=&enviar=Pesquisar"},{"data":"2023-09-19","hora":"16:24","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado comemorou a retomada da obra de duplicação da BR-316, que se estende de Castanhal a Santa Maria do Pará, destacando sua importância para a segurança e a economia paraense. Agradeceu ao Governador Helder Barbalho e à bancada do Pará por defenderem os interesses da região e informou que 20 quilômetros da duplicação serão concluídos ainda este ano, com a conclusão total prevista para o próximo ano.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=20%2F9%2F2023&txPagina=79&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2024-W51","autorias":0,"votos":17,"relatorias":0,"discursos":0},{"semana":"2024-W50","autorias":0,"votos":3,"relatorias":2,"discursos":0},{"semana":"2024-W48","autorias":1,"votos":2,"relatorias":0,"discursos":0},{"semana":"2024-W46","autorias":0,"votos":3,"relatorias":0,"discursos":0},{"semana":"2024-W45","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W44","autorias":0,"votos":3,"relatorias":0,"discursos":1},{"semana":"2024-W42","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2024-W38","autorias":1,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W37","autorias":0,"votos":17,"relatorias":0,"discursos":0},{"semana":"2024-W35","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W33","autorias":0,"votos":7,"relatorias":0,"discursos":0},{"semana":"2024-W28","autorias":2,"votos":4,"relatorias":0,"discursos":0},{"semana":"2024-W24","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2024-W22","autorias":0,"votos":5,"relatorias":0,"discursos":0},{"semana":"2024-W21","autorias":1,"votos":12,"relatorias":0,"discursos":1},{"semana":"2024-W20","autorias":0,"votos":3,"relatorias":0,"discursos":0},{"semana":"2024-W19","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2024-W17","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2024-W16","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2024-W13","autorias":0,"votos":4,