rtido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2502719-8","proposicao_id":2500260,"sigla":"PL 1856/2025","data":"2025-08-12","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2500260-34","proposicao_id":2500260,"sigla":"PL 1856/2025","data":"2025-08-12","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2500260-31","proposicao_id":2500260,"sigla":"PL 1856/2025","data":"2025-08-12","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2500260-26","proposicao_id":2500260,"sigla":"PL 1856/2025","data":"2025-08-12","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2472106-8","proposicao_id":2432423,"sigla":"PL 1707/2024","data":"2025-08-12","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"146708-38","proposicao_id":146708,"sigla":"PL 6056/2025","data":"2025-08-12","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2498090-47","proposicao_id":2498090,"sigla":"MPV 1296/2025","data":"2025-08-07","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2498090-44","proposicao_id":2498090,"sigla":"MPV 1296/2025","data":"2025-08-07","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null}],"discursos":[{"data":"2026-04-08","hora":"19:16","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"A Deputada orientou a bancada na votação, em primeiro turno, da Emenda Aglutinativa nº 2 apresentada à Proposta de Emenda à Constituição (PEC) nº 383, de 2017, que altera a Constituição Federal para garantir recursos mínimos para o financiamento do Sistema Único de Assistência Social (SUAS).","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=9%2F4%2F2026&txPagina=215&txSuplemento=&enviar=Pesquisar"},{"data":"2025-10-08","hora":"17:16","tipo":"COMO LÍDER","fase":"Breves Comunicações","sumario":"A Deputada manifestou gratidão a Deus e ao povo do Amapá ao anunciar seu licenciamento do mandato parlamentar para reassumir a Secretaria de Estado de Assistência Social, a convite do Governador Clécio Luís. Recordou sua atuação anterior na pasta, quando criou, com apoio do Senador Davi Alcolumbre, os programas Acolher Amapá e Amapá sem Fome. Ademais, informou que sua sucessora será a Deputada Fátima Pelaes, que dará continuidade às ações voltadas à primeira infância, à proteção das mulheres e ao fortalecimento da assistência social. Ao final, agradeceu ao Presidente da Câmara dos Deputados, Hugo Motta, ao Republicanos, às bancadas do Amapá e do Norte bem como aos demais Parlamentares pelo apoio, reafirmando seu compromisso de combater a fome e ampliar a dignidade das famílias amapaenses.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=9%2F10%2F2025&txPagina=106&txSuplemento=&enviar=Pesquisar"},{"data":"2025-08-19","hora":"19:16","tipo":"COMO LÍDER","fase":"Ordem do Dia","sumario":"A Deputada retomou o mandato na Câmara após decisão judicial que corrigiu falhas na legislação eleitoral de 2022, quando quatro eleitos pelo Amapá não puderam assumir. Destacou sua atuação como Secretária de Assistência Social no governo Clécio Luís, período em que participou da criação e execução do programa Amapá Sem Fome, responsável pela entrega de mais de 150 mil cestas e pelo avanço nos índices de segurança alimentar e redução da extrema pobreza. Ressaltou ainda a geração de empregos, a convocação de concursados e a transposição de servidores. Defendeu a pauta da Proposta de Emenda à Constituição nº 47, de 2023, que altera o art. 31 da Emenda Constitucional nº 19, de 4 de junho de 1998, para prever a inclusão, em quadro em extinção da administração pública federal, de servidor público, de integrante da carreira de policial, civil ou militar, e de pessoa que haja mantido relação ou vínculo funcional, empregatício, estatutário ou de trabalho com a administração pública dos ex-Territórios ou dos Estados do Amapá, de Roraima ou de Rondônia, inclusive suas prefeituras, durante os 10 (dez) primeiros anos da criação dessas unidades federadas; estabelece o parâmetro remuneratório para a Polícia Militar dos ex-Territórios Federais; e dá outras providências. Cobrou regulamentação do ambiente digital e anunciou a entrega da Casa da Mulher Brasileira no Amapá, fruto de emenda parlamentar. Também agradeceu apoio familiar, político e institucional.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=20%2F8%2F2025&txPagina=160&txSuplemento=&enviar=Pesquisar"},{"data":"2025-08-19","hora":"17:40","tipo":"PELA ORDEM","fase":"Ordem do Dia","sumario":"A Deputada orientou a bancada na votação do requerimento de urgência apresentado ao Projeto de Resolução nº 63, de 2025, que altera o Código de Ética e Decoro Parlamentar e o Regimento Interno da Câmara dos Deputados para prever as condutas de agressão física e de obstaculização física do funcionamento das atividades legislativas, e dá outras providências. Além disso, defendeu a imediata inclusão na pauta do Projeto de Lei nº 2.628, de 2022, que trata da proteção de crianças e adolescentes nos ambientes digitais.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=20%2F8%2F2025&txPagina=128&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2026-W44","autorias":1,"votos":0,"relatorias":0,"discursos":0},{"semana":"2026-W42","autorias":1,"votos":2,"relatorias":0,"discursos":0},{"semana":"2026-W39","autorias":3,"votos":