OS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2360457-45","proposicao_id":2360457,"sigla":"PL 2379/2023","data":"2025-03-25","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2360457-42","proposicao_id":2360457,"sigla":"PL 2379/2023","data":"2025-03-25","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2486199-35","proposicao_id":2486199,"sigla":"PLP 58/2025","data":"2025-03-18","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2486199-32","proposicao_id":2486199,"sigla":"PLP 58/2025","data":"2025-03-18","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2485066-33","proposicao_id":2485066,"sigla":"PLP 22/2025","data":"2025-03-18","orgao":"PLEN","voto":"Sim","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2485066-28","proposicao_id":2485066,"sigla":"PLP 22/2025","data":"2025-03-18","orgao":"PLEN","voto":"Não","partido":"REPUBLICANOS","orientacao_partido":null,"orientacao_bancada":null}],"discursos":[{"data":"2025-03-27","hora":"10:48","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"A Deputada celebrou seu primeiro mês de mandato e reafirmou seu compromisso com a causa animal, agradecendo ao Deputado Federal Euclydes Pettersen, aos eleitores de Juiz de Fora (MG) e à família, especialmente à filha Bruna e ao irmão Noraldino Júnior, Deputado Estadual e idealizador do projeto Castramóvel. Destacou que o programa já castrou mais de 250 mil animais e aplicou mais de 150 mil doses de vacinas éticas em Minas Gerais. Reafirmou que a proteção animal será sua principal bandeira, defendeu a criação de leis contra maus-tratos e enfatizou a participação majoritária das voluntárias e ativistas mulheres na causa animal. Apontou os benefícios da convivência com animais para idosos e pessoas com deficiência e citou versículo bíblico sobre o cuidado com os animais. Ao final, alertou para o aumento das denúncias de maus-tratos e pediu apoio dos colegas Parlamentares à pauta de bem-estar animal.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=28%2F3%2F2025&txPagina=52&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2025-W26","autorias":3,"votos":3,"relatorias":0,"discursos":0},{"semana":"2025-W24","autorias":1,"votos":12,"relatorias":0,"discursos":0},{"semana":"2025-W23","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2025-W22","autorias":2,"votos":12,"relatorias":0,"discursos":0},{"semana":"2025-W21","autorias":3,"votos":3,"relatorias":0,"discursos":0},{"semana":"2025-W19","autorias":2,"votos":4,"relatorias":0,"discursos":0},{"semana":"2025-W18","autorias":0,"votos":11,"relatorias":0,"discursos":0},{"semana":"2025-W17","autorias":0,"votos":6,"relatorias":0,"discursos":0},{"semana":"2025-W15","autorias":0,"votos":4,"relatorias":2,"discursos":0},{"semana":"2025-W14","autorias":0,"votos":6,"relatorias":1,"discursos":0},{"semana":"2025-W13","autorias":0,"votos":4,"relatorias":0,"discursos":1},{"semana":"2025-W12","autorias":0,"votos":4,"relatorias":0,"discursos":0}],"gerado_em":"2026-11-08T17:47:05Z"}