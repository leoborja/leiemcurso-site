","data":"2025-07-01","orgao":"PLEN","voto":"Não","partido":"MDB","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2381043-91","proposicao_id":2381043,"sigla":"PL 4035/2023","data":"2025-06-26","orgao":"PLEN","voto":"Sim","partido":"MDB","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2381043-85","proposicao_id":2381043,"sigla":"PL 4035/2023","data":"2025-06-26","orgao":"PLEN","voto":"Não","partido":"MDB","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2465240-36","proposicao_id":2465240,"sigla":"PL 3118/2024","data":"2025-06-25","orgao":"PLEN","voto":"Sim","partido":"MDB","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2383019-91","proposicao_id":2383019,"sigla":"PLP 177/2023","data":"2025-06-25","orgao":"PLEN","voto":"Sim","partido":"MDB","orientacao_partido":null,"orientacao_bancada":null},{"votacao_id":"2383019-86","proposicao_id":2383019,"sigla":"PLP 177/2023","data":"2025-06-25","orgao":"PLEN","voto":"Não","partido":"MDB","orientacao_partido":null,"orientacao_bancada":null}],"discursos":[{"data":"2025-08-20","hora":"16:48","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado destacou o desempenho educacional do Ceará, reconhecido pela Deutsche Welle, com 85,3% das crianças do ensino fundamental alfabetizadas na idade certa, superando a média nacional de 59,2% e a meta do MEC para 2030, de 80%. Atribuiu o resultado a políticas educacionais iniciadas há mais de 20 anos por Cid Gomes e mantidas por Camilo Santana, atual Ministro da Educação, ressaltando investimentos contínuos, incluindo 400 milhões de reais para escolas de tempo integral e inauguração de unidade voltada a estudantes quilombolas. Finalizou registrando a presença do ex-Deputado Raimundo Macedo e de seu filho.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=21%2F8%2F2025&txPagina=160&txSuplemento=&enviar=Pesquisar"},{"data":"2025-07-15","hora":"16:08","tipo":"BREVES COMUNICAÇÕES","fase":"Breves Comunicações","sumario":"O Deputado destacou a importância da Exposição Agropecuária de Crato (Expocrato), realizada na cidade do Crato (CE), como vitrine do avanço tecnológico, econômico e cultural do agronegócio do Cariri e do Ceará. Recordou que o evento teve início em 1944 e se consolidou como referência regional, hoje com projeção nacional. Ressaltou que a Exposição, em sua 72ª edição, deve atrair 12 milhões de visitantes e movimentar mais de R$ 140 milhões, com forte impacto na geração de empregos e renda. Assinalou ainda o apoio do Banco do Nordeste, que projeta mais de R$ 132 milhões em financiamentos voltados ao agronegócio e ao empreendedorismo urbano e rural. Por fim, convidou os brasileiros a conhecerem a Expocrato, evento que exalta a tradição e o dinamismo do Ceará.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=16%2F7%2F2025&txPagina=80&txSuplemento=&enviar=Pesquisar"},{"data":"2025-06-16","hora":"18:04","tipo":"PELA ORDEM","fase":"Breves Comunicações","sumario":"O Deputado agradeceu a oportunidade de assumir uma cadeira na Câmara dos Deputados, destacando o apoio da família e, em especial, de seu pai, Raimundinho, ex-Prefeito de Russas (CE). Expressou reconhecimento ao ex-Senador Eunício Oliveira, presidente do MDB no Ceará, por tê-lo indicado ao mandato. Também agradeceu ainda ao Governador Elmano de Freitas pelo período em que atuou como assessor especial no Governo Estadual do Ceará. Ao final, reafirmou seu compromisso com o povo cearense, mencionando o apoio das regiões do Vale do Jaguaribe e do Cariri, onde foi o Deputado mais votado, e colocou-se à disposição para trabalhar junto à bancada do Ceará.","url":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=17%2F6%2F2025&txPagina=32&txSuplemento=&enviar=Pesquisar"}],"semanas":[{"semana":"2025-W41","autorias":0,"votos":1,"relatorias":0,"discursos":0},{"semana":"2025-W39","autorias":0,"votos":9,"relatorias":0,"discursos":0},{"semana":"2025-W38","autorias":0,"votos":7,"relatorias":0,"discursos":0},{"semana":"2025-W37","autorias":0,"votos":5,"relatorias":0,"discursos":0},{"semana":"2025-W35","autorias":0,"votos":6,"relatorias":0,"discursos":0},{"semana":"2025-W34","autorias":0,"votos":7,"relatorias":0,"discursos":1},{"semana":"2025-W33","autorias":0,"votos":10,"relatorias":0,"discursos":0},{"semana":"2025-W32","autorias":0,"votos":2,"relatorias":1,"discursos":0},{"semana":"2025-W29","autorias":0,"votos":14,"relatorias":1,"discursos":1},{"semana":"2025-W28","autorias":0,"votos":5,"relatorias":0,"discursos":0},{"semana":"2025-W27","autorias":0,"votos":2,"relatorias":0,"discursos":0},{"semana":"2025-W26","autorias":0,"votos":5,"relatorias":0,"discursos":0},{"semana":"2025-W25","autorias":0,"votos":0,"relatorias":0,"discursos":1}],"gerado_em":"2026-11-08T17:47:05Z"}